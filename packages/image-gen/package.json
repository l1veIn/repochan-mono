{
  "name": "@repochan/image-gen",
  "version": "0.1.0",
  "description": "Image generation library for RepoChan — prompt→PNG via OpenAI-compatible endpoints (sync + optional async queue). Credentials self-managed, no .repochan/ protocol writes.",
  "type": "module",
  "license": "MIT",
  "author": "l1veIn",
  "homepage": "https://github.com/l1veIn/repochan-mono/tree/main/packages/image-gen",
  "bugs": {
    "url": "https://github.com/l1veIn/repochan-mono/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l1veIn/repochan-mono.git",
    "directory": "packages/image-gen"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "package.json"],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  }
}
