{
  "name": "@repochan/image-edit",
  "version": "0.3.0",
  "description": "Zero-credential local pixel operations for RepoChan: grid slicing and ML sticker extraction.",
  "type": "module",
  "license": "MIT",
  "author": "l1veIn",
  "homepage": "https://github.com/l1veIn/repochan-mono/tree/main/packages/image-edit",
  "bugs": {
    "url": "https://github.com/l1veIn/repochan-mono/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l1veIn/repochan-mono.git",
    "directory": "packages/image-edit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/vendor/imagetracer.cjs', 'dist/vendor/imagetracer.cjs')\"",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  }
}
