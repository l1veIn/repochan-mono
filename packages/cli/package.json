{
  "name": "repochan",
  "version": "0.4.3",
  "description": "RepoChan CLI — a deterministic, agent-driven creative pipeline. Manages .repochan/ protocol entities; no embedded runtime.",
  "type": "module",
  "license": "MIT",
  "author": "l1veIn",
  "homepage": "https://github.com/l1veIn/repochan-mono/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/l1veIn/repochan-mono/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l1veIn/repochan-mono.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "repochan": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@repochan/browse": "workspace:*",
    "@repochan/core": "workspace:*",
    "@repochan/image-edit": "workspace:*",
    "@repochan/image-gen": "workspace:*",
    "@repochan/skill": "workspace:*",
    "@repochan/templates": "workspace:*",
    "cac": "^6.7.14",
    "chalk": "^5.6.2",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@repochan/starters": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  }
}
