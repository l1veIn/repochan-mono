{
  "name": "repochan-pi",
  "version": "0.1.0",
  "description": "Pi package for manual multi-role workflows that turn git repositories into RepoChan mascot personas and visual brand assets.",
  "type": "module",
  "keywords": [
    "pi-package",
    "repochan",
    "mascot",
    "brand-assets",
    "creative-workflow"
  ],
  "license": "MIT",
  "author": "l1veIn",
  "homepage": "https://github.com/l1veIn/repochan-mono/tree/main/packages/pi",
  "bugs": {
    "url": "https://github.com/l1veIn/repochan-mono/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l1veIn/repochan-mono.git",
    "directory": "packages/pi"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./extensions/repochan.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@repochan/core": "workspace:*",
    "typebox": "^1.0.55"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.79.2",
    "@types/node": "^25.9.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "README.md",
    "AGENTS.md",
    "extensions",
    "skills",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build",
    "lint": "tsc -p tsconfig.json --noEmit"
  }
}
