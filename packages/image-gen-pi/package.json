    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.78.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@types/node": "^25.9.3",
    "typebox": "^1.1.39",
    "typescript": "^5.9.3"
  },
  "files": [
    "README.md",
    "AGENTS.md",
    "extensions",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build",
    "lint": "tsc -p tsconfig.json --noEmit"
  }
}
