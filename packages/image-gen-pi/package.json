{
  "name": "@repochan/image-gen-pi",
  "version": "0.1.0",
  "description": "Multi-provider image generation Pi package with Codex OAuth and FAL.ai support.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "image-generation",
    "codex",
    "fal",
    "gpt-image-2"
  ],
  "license": "MIT",
  "author": "l1veIn",
  "homepage": "https://github.com/l1veIn/repochan-mono/tree/main/packages/image-gen-pi",
  "bugs": {
    "url": "https://github.com/l1veIn/repochan-mono/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l1veIn/repochan-mono.git",
    "directory": "packages/image-gen-pi"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
