{
  "schemaVersion": "repochan.starter-assets.v1",
  "assets": {
    "hero-master": {
      "kind": "scalar",
      "src": "/assets/hero-frutiger.webp",
      "status": "source"
    },
    "cutout": {
      "kind": "scalar",
      "src": "/assets/cutout.webp",
      "status": "source"
    },
    "foundation": {
      "kind": "scalar",
      "src": "/assets/foundation.webp",
      "status": "source",
      "orderId": "ord-foundation-001"
    },
    "banner": {
      "kind": "scalar",
      "src": "/assets/banner.webp",
      "status": "source",
      "orderId": "ord-banner-001"
    },
    "pattern": {
      "kind": "scalar",
      "src": "/assets/pattern.webp",
      "status": "source",
      "orderId": "ord-pattern-001"
    },
    "poster": {
      "kind": "scalar",
      "src": "/assets/poster.webp",
      "status": "source",
      "orderId": "ord-poster-001"
    },
    "stickers": {
      "kind": "scalar",
      "src": "/assets/stickers.webp",
      "status": "source",
      "orderId": "ord-sticker-001"
    },
    "icon": {
      "kind": "scalar",
      "src": "/assets/icon.webp",
      "status": "source",
      "orderId": "ord-icon-001"
    },
    "webstates": {
      "kind": "bundle",
      "status": "source",
      "orderId": "ord-webstates-001",
      "items": {
        "loading": { "src": "/assets/webstates/tile-0.webp", "status": "source" },
        "empty": { "src": "/assets/webstates/tile-1.webp", "status": "source" },
        "success": { "src": "/assets/webstates/tile-2.webp", "status": "source" },
        "not-found": { "src": "/assets/webstates/tile-3.webp", "status": "source" },
        "error": { "src": "/assets/webstates/tile-4.webp", "status": "source" },
        "welcome": { "src": "/assets/webstates/tile-5.webp", "status": "source" },
        "searching": { "src": "/assets/webstates/tile-6.webp", "status": "source" },
        "cta": { "src": "/assets/webstates/tile-7.webp", "status": "source" },
        "cozy": { "src": "/assets/webstates/tile-8.webp", "status": "source" }
      }
    }
  }
}
