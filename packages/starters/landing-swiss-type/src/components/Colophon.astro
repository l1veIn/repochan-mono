---
import { assets, alternatePath, type Locale } from "../lib/site";
import type { ColophonContent } from "../lib/i18n/types";

type Props = { content: ColophonContent; locale: Locale };
const { content, locale } = Astro.props;
---

<footer class="colophon">
  <div class="container colophon-inner">
    <div class="colophon-text">
      {content.lines.map((line) => <p class="line mono">{line}</p>)}
      <p class="line mono">
        <a href={alternatePath(locale)}>{content.localeSwitchLabel}</a>
        {" · "}
        {content.copyright}
      </p>
    </div>
    <figure class="cameo">
      <img
        src={assets.footerCutout.src}
        alt={content.cutoutAlt}
        width="120"
        height="120"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="mono">{content.cutoutCaption}</figcaption>
    </figure>
  </div>
</footer>

<style>
  .colophon {
    padding-block: 48px;
  }

  .colophon-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .line {
    margin: 0 0 4px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .cameo {
    margin: 0;
    text-align: right;
  }

  .cameo img {
    width: 120px;
    height: 120px;
    object-fit: contain;
    margin-left: auto;
  }

  .cameo figcaption {
    margin-top: 8px;
    font-size: 0.6875rem;
    color: var(--muted);
  }
</style>
