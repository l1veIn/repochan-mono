---
import type { TypeTrackContent } from "../lib/i18n/types";

type Props = { content: TypeTrackContent };
const { content } = Astro.props;
// 重复 4 遍保证无缝横向字轨
const sequence = [...content.items, ...content.items, ...content.items, ...content.items];
---

<div class="type-track" aria-hidden="true">
  <div class="track-inner">
    {
      [0, 1].map(() => (
        <span class="track-seq mono">
          {sequence.map((item) => (
            <span class="track-item">
              {item}
              <span class="arrow">→</span>
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .type-track {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
    padding-block: 12px;
  }

  .track-inner {
    display: flex;
    width: max-content;
    animation: track-scroll 40s linear infinite;
  }

  .track-seq {
    display: inline-flex;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.2em;
  }

  .track-item {
    display: inline-flex;
    gap: 1.5em;
    padding-right: 1.5em;
  }

  .arrow {
    color: var(--accent);
  }

  @keyframes track-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-inner {
      animation: none;
    }
  }
</style>
