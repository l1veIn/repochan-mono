        "PERSONA",
        "PAINT",
        "PAGE"
      ]
    },
    "thesis": {
      "index": "02",
      "title": "Thesis",
      "note": "Three short definitions. Nominalized. No ornament.",
      "items": [
        {
          "no": "02.1",
          "term": "WHAT",
          "def": "A CLI and a .repochan/ protocol directory that scans a git repository and emits structured specs for brand assets."
        },
        {
          "no": "02.2",
          "term": "HOW",
          "def": "Deterministic scans first, external-agent orchestration second. The CLI reads and writes protocol; it makes no creative judgments."
        },
        {
          "no": "02.3",
          "term": "OUTPUT",
          "def": "Persona, foundation sheet, stickers, posters, landing pages. Every artifact has an order, a version, and a traceable origin."
        }
      ]
    },
    "pipeline": {
      "index": "03",
      "title": "Pipeline Spec",
      "note": "Six steps. One command and one protocol artifact per step.",
      "head": {
        "step": "Step",
        "input": "Input",
        "output": "Output",
        "command": "Command"
      },
      "rows": [
        {
          "no": "03.1",
          "name": "Init",
          "input": "git repository",
          "output": ".repochan/ protocol dir",
          "cmd": "repochan init"
        },
        {
          "no": "03.2",
          "name": "Analysis",
          "input": "source · README · history",
          "output": "analysis report",
          "cmd": "repochan analysis"
        },
        {
          "no": "03.3",
          "name": "Interview",
          "input": "analysis report",
          "output": "interview report",
          "cmd": "repochan interview create"
        },
        {
          "no": "03.4",
          "name": "Persona",
          "input": "analysis + interview",
          "output": "mascot persona",
          "cmd": "repochan persona create"
        },
        {
          "no": "03.5",
          "name": "Paint",
          "input": "persona + templates",
          "output": "foundation / stickers / posters",
          "cmd": "repochan order create · image gen"
        },
        {
          "no": "03.6",
          "name": "Assemble",
          "input": "assets + copy",
          "output": "landing site",
          "cmd": "repochan starter pull"
        }
      ]
