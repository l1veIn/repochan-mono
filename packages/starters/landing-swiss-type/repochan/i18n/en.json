      "docIndex": "DOC / 01",
      "iconAlt": "RepoChan icon"
    },
    "hero": {
      "index": "01",
      "kicker": "CLI + PROTOCOL · AGENT BYO",
      "lines": [
        "TURN A REPO",
        "INTO A",
        "BRAND SPEC."
      ],
      "sub": "The tool never thinks. The agent decides. Every artifact is versioned.",
      "installCmd": "npm install -g repochan",
      "copyLabel": "Copy",
      "copiedLabel": "Copied",
      "footnote": "Readable static · complete without JS · type ≥ 70% / image ≤ 30%",
      "figCaption": "Fig. 01 — mascot cutout B · open-palm gesture · ord-cutout-001 (complete-in-frame)",
      "figAlt": "RepoChan mascot cutout: leaning forward, open palm reaching toward the viewer"
