  "meta": {
    "title": "RepoChan — Turn a repo into a deliverable brand spec",
    "description": "RepoChan is a CLI and a .repochan/ protocol: it compiles a git repository into versioned, traceable brand assets — persona, foundation sheet, stickers, posters, landing pages."
  },
  "content": {
    "masthead": {
      "wordmark": "RepoChan",
