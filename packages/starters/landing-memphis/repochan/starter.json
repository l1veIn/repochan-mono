{
  "schemaVersion": "repochan.starter.v1",
  "id": "landing-memphis",
  "name": "形状乐园 · Memphis Playground",
  "description": "RepoChan's own Memphis-playground landing page: a geometric shape stage with a die-cut hero cutout, six toy-block pipeline cards, a sticker orbit carousel with a Memphis poster centerpiece, play-rule cards and a confetti CTA with a second cutout riding the block edge. zh default locale with a full en edition; every visual is real pipeline output.",
  "style": "memphis-playground",
  "tags": [
    "landing",
    "memphis",
    "geometric",
    "playful",
    "shape-stage",
    "confetti",
    "bilingual"
  ],
  "previews": {
    "desktop": "repochan/previews/desktop.webp",
    "mobile": "repochan/previews/mobile.webp"
  },
  "config": {
    "site": "repochan/site.json",
    "assets": "repochan/assets.json",
    "i18nDir": "repochan/i18n"
  },
  "content": {
    "defaultLocale": "zh",
    "supportedLocales": [
      "zh",
      "en"
    ]
  },
  "assets": [
    {
      "kind": "scalar",
      "slot": "hero-cutout",
      "required": true,
      "reference": "repochan/references/hero-cutout-matte.webp",
      "output": "public/assets/hero-cutout.webp",
      "description": "Full-body die-cut cutout riding the hero shape stage — the page's main visual, transparent webp produced by chroma-key + compress. Reference is the raw matte master (2:3).",
      "order": {
        "assetType": "character_cutout",
        "templateId": "official/character-cutout",
        "brief": {
          "intent": "Regenerate the hero-stage cutout for the downstream project's character, keeping the reference matte's full-body framing and playful in-air energy so it can ride the edge of a geometric shape.",
          "mustInclude": [
            "one full-body character in a playful mid-air pose, fully inside the canvas",
            "perfectly flat uniform matte background in a color absent from the character",
            "vertical 2:3 framing, character centered"
          ],
          "avoid": [
            "text",
            "letters",
            "scenery",
            "shadows on the matte",
            "cropped limbs or props"
          ],
          "creativeFreedom": [
            "character outfit details",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "cutout-matte",
            "format": "png",
            "width": 1024,
            "height": 1536,
            "aspectRatio": "2:3",
            "genSize": "2048x3072"
          }
        ]
      },
      "postprocess": [
        {
          "op": "chroma-key",
          "args": {
            "matte": "auto",
            "pipeline": "v2"
          },
          "out": "public/assets/hero-cutout.png"
        },
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 88,
            "maxWidth": 1600
          },
          "out": "public/assets/hero-cutout.webp"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "cta-cutout",
      "required": true,
      "reference": "repochan/references/cta-cutout-matte.webp",
      "output": "public/assets/cutout-wave.webp",
      "description": "Second die-cut cutout riding the edge of the closing CTA color block — transparent webp produced by chroma-key + compress. Reference is the raw matte master (1:1).",
      "order": {
        "assetType": "character_cutout",
        "templateId": "official/character-cutout",
        "brief": {
          "intent": "Regenerate the closing-CTA cutout for the downstream project's character: a friendly waving/presenting pose that reads while perched on the edge of a large color block.",
          "mustInclude": [
            "one full-body character waving or presenting, fully inside the canvas",
            "perfectly flat uniform matte background in a color absent from the character",
            "square 1:1 framing, character centered"
          ],
          "avoid": [
            "text",
            "letters",
            "scenery",
            "shadows on the matte",
            "cropped limbs or props"
          ],
          "creativeFreedom": [
            "character outfit details",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "cutout-matte",
            "format": "png",
            "width": 1024,
            "height": 1024,
            "aspectRatio": "1:1",
            "genSize": "2048x2048"
          }
        ]
      },
      "postprocess": [
        {
          "op": "chroma-key",
          "args": {
            "matte": "auto",
            "pipeline": "v2"
          },
          "out": "public/assets/cutout-wave.png"
        },
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 88,
            "maxWidth": 1600
          },
          "out": "public/assets/cutout-wave.webp"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "icon",
      "required": true,
      "output": "public/assets/icon.webp",
      "description": "Project icon — nav badge; also the favicon source (favicon.ico / apple-touch-icon.png / icon-192.png / icon-512.png are derived from it offline via compress + favicon + resize).",
      "order": {
        "assetType": "icon",
        "templateId": "official/icon-single",
        "brief": {
          "mustInclude": [
            "one scalable brand mark reading cleanly at 38px",
            "project motif without any letterforms"
          ],
          "avoid": [
            "text",
            "letters",
            "watermarks"
          ],
          "creativeFreedom": [
            "mark geometry",
            "accent colors from the project palette"
          ]
        },
        "deliverables": [
          {
            "name": "icon",
            "format": "png",
            "width": 512,
            "height": 512,
            "aspectRatio": "1:1",
            "genSize": "1024x1024"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 90,
            "maxWidth": 512
          },
          "out": "public/assets/icon.webp"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "memphis-poster",
      "required": true,
      "output": "public/assets/memphis-poster.webp",
      "description": "Memphis geometric poster — the carousel's arched centerpiece; square 1:1, generated at 4K-class resolution and compressed to 1536px webp.",
      "order": {
        "assetType": "poster",
        "templateId": "official/poster-memphis",
        "brief": {
          "intent": "Repaint the Memphis geometric poster for the downstream project: asymmetrical geometric partitions, clashing optimistic palette and the project character integrated among zigzags, circles, arches and dots.",
          "mustInclude": [
            "Memphis-style asymmetrical composition with hard-edge geometric shapes (zigzag, circle, arch, ring, dots)",
            "the project character integrated among the shapes",
            "square 1:1 framing that crops cleanly into an arch mask"
          ],
          "avoid": [
            "rendered text",
            "logos",
            "UI baked into the image",
            "watermarks"
          ],
          "creativeFreedom": [
            "shape arrangement and palette rotation within the project identity",
            "selective dimensional shadows"
          ]
        },
        "deliverables": [
          {
            "name": "poster",
            "format": "png",
            "width": 1536,
            "height": 1536,
            "aspectRatio": "1:1",
            "genSize": "3840x3840"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 82,
            "maxWidth": 1536
          },
          "out": "public/assets/memphis-poster.webp"
        }
      ]
    },
    {
      "kind": "bundle",
      "slot": "stickers",
      "required": true,
      "reference": "repochan/references/stickers-grid.webp",
      "publications": [
        {
          "key": "welcome",
          "cell": 0,
          "output": "public/assets/stickers/sticker-0.webp"
        },
        {
          "key": "searching",
          "cell": 1,
          "output": "public/assets/stickers/sticker-1.webp"
        },
        {
          "key": "loading",
          "cell": 2,
          "output": "public/assets/stickers/sticker-2.webp"
        },
        {
          "key": "empty",
          "cell": 3,
          "output": "public/assets/stickers/sticker-3.webp"
        },
        {
          "key": "error",
          "cell": 4,
          "output": "public/assets/stickers/sticker-4.webp"
        },
        {
          "key": "success",
          "cell": 5,
          "output": "public/assets/stickers/sticker-5.webp"
        },
        {
          "key": "not-found",
          "cell": 6,
          "output": "public/assets/stickers/sticker-6.webp"
        },
        {
          "key": "cta",
          "cell": 7,
          "output": "public/assets/stickers/sticker-7.webp"
        },
        {
          "key": "cozy",
          "cell": 8,
          "output": "public/assets/stickers/sticker-8.webp"
        }
      ],
      "description": "Nine die-cut chibi stickers — the hero stage badge (cell 0) and the six pipeline-block companions (cells 1-6) plus the sticker orbit (cells 0-7). sticker-N.webp is cell N of the 3×3 grid; the source grid's cell semantics (chibi expressions) differ from the template's fixed keys, and the keys are the positional replacement contract for downstream regeneration.",
      "order": {
        "assetType": "web_state_stickers",
        "templateId": "official/web-state-grid-3x3",
        "brief": {
          "mustInclude": [
            "strict 3×3 grid of the project character in the nine fixed web-state poses (template cell semantics)",
            "perfectly flat uniform matte background in a color absent from the character, identical in every pixel outside the stickers"
          ],
          "avoid": [
            "text",
            "letters",
            "numbers",
            "borders",
            "grid lines",
            "scenery",
            "shadows on the matte"
          ],
          "creativeFreedom": [
            "expression and pose details inside each fixed semantic",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "sticker-grid",
            "format": "png",
            "width": 1024,
            "height": 1024,
            "aspectRatio": "1:1",
            "genSize": "2048x2048"
          }
        ]
      },
      "postprocess": [
        {
          "op": "extract-grid",
          "args": {
            "rows": 3,
            "cols": 3,
            "strategy": "chroma-grid",
            "mapping": {
              "welcome": 0,
              "searching": 1,
              "loading": 2,
              "empty": 3,
              "error": 4,
              "success": 5,
              "not-found": 6,
              "cta": 7,
              "cozy": 8
            },
            "normalize": {
              "canvasSize": 640,
              "padding": 10
            },
            "chroma": {
              "matteColor": "auto",
              "pipeline": "v2",
              "matteSelect": "subject-aware"
            },
            "geometry": {
              "mode": "centroid-components"
            },
            "qa": {
              "alphaThreshold": 32,
              "minForegroundRatio": 0.05,
              "maxForegroundRatio": 0.9,
              "maxSheetEdgeTouchRatio": 0.05
            },
            "format": "webp",
            "quality": 80
          },
          "out": "public/assets/stickers"
        }
      ]
    },
    {
      "kind": "bundle",
      "slot": "webstates",
      "required": true,
      "reference": "repochan/references/webstates-grid.webp",
      "publications": [
        {
          "key": "welcome",
          "cell": 0,
          "output": "public/assets/webstates/state-0.webp"
        },
        {
          "key": "searching",
          "cell": 1,
          "output": "public/assets/webstates/state-1.webp"
        },
        {
          "key": "loading",
          "cell": 2,
          "output": "public/assets/webstates/state-2.webp"
        },
        {
          "key": "empty",
          "cell": 3,
          "output": "public/assets/webstates/state-3.webp"
        },
        {
          "key": "error",
          "cell": 4,
          "output": "public/assets/webstates/state-4.webp"
        },
        {
          "key": "success",
          "cell": 5,
          "output": "public/assets/webstates/state-5.webp"
        },
        {
          "key": "not-found",
          "cell": 6,
          "output": "public/assets/webstates/state-6.webp"
        },
        {
          "key": "cta",
          "cell": 7,
          "output": "public/assets/webstates/state-7.webp"
        },
        {
          "key": "cozy",
          "cell": 8,
          "output": "public/assets/webstates/state-8.webp"
        }
      ],
      "description": "Web-state chibi illustrations; all nine cells run in the carousel's seamless marquee strip. state-N.webp is cell N of the 3×3 grid; the source grid's cell semantics (loading/empty/success/not-found/error/welcome/searching/maintenance/cozy) differ from the template's fixed keys, and the keys are the positional replacement contract for downstream regeneration.",
      "order": {
        "assetType": "web_state_stickers",
        "templateId": "official/web-state-grid-3x3",
        "brief": {
          "mustInclude": [
            "strict 3×3 grid of the project character in the nine fixed web-state poses (template cell semantics)",
            "perfectly flat uniform matte background in a color absent from the character, identical in every pixel outside the stickers"
          ],
          "avoid": [
            "text",
            "letters",
            "numbers",
            "borders",
            "grid lines",
            "scenery",
            "shadows on the matte"
          ],
          "creativeFreedom": [
            "pose details inside each fixed semantic",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "webstate-grid",
            "format": "png",
            "width": 1024,
            "height": 1024,
            "aspectRatio": "1:1",
            "genSize": "2048x2048"
          }
        ]
      },
      "postprocess": [
        {
          "op": "extract-grid",
          "args": {
            "rows": 3,
            "cols": 3,
            "strategy": "chroma-grid",
            "mapping": {
              "welcome": 0,
              "searching": 1,
              "loading": 2,
              "empty": 3,
              "error": 4,
              "success": 5,
              "not-found": 6,
              "cta": 7,
              "cozy": 8
            },
            "normalize": {
              "canvasSize": 640,
              "padding": 10
            },
            "chroma": {
              "matteColor": "auto",
              "pipeline": "v2",
              "matteSelect": "subject-aware"
            },
            "geometry": {
              "mode": "centroid-components"
            },
            "qa": {
              "alphaThreshold": 32,
              "minForegroundRatio": 0.05,
              "maxForegroundRatio": 0.9,
              "maxSheetEdgeTouchRatio": 0.1
            },
            "format": "webp",
            "quality": 80
          },
          "out": "public/assets/webstates"
        }
      ]
    }
  ]
}
