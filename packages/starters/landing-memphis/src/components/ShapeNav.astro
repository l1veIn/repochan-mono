---
import Shape from "./Shape.astro";
import { assets, alternatePath, type Locale } from "../lib/site";
import type { SiteContent } from "../lib/i18n/types";

type Props = { content: SiteContent["nav"]; locale: Locale };
const { content, locale } = Astro.props;

const shapeColors = { circle: "pink", triangle: "yellow", square: "cyan" } as const;
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="nav-brand" href="#top" aria-label="RepoChan">
      <img src={assets.icon.src} alt="" width="38" height="38" />
      {content.brand}
      <span class="nav-tag">{content.tag}</span>
    </a>
    <ul class="nav-links">
      {content.links.map((link) => (
        <li>
          <a href={link.href}>
            <Shape kind={link.shape} color={shapeColors[link.shape]} size={16} />
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="nav-actions">
      <a class="nav-locale" href={alternatePath(locale)}>{content.localeSwitch}</a>
      <a class="btn btn--small" href="#rules">{content.cta}</a>
    </div>
  </div>
</header>
