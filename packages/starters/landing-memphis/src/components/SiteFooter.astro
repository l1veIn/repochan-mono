---
import Shape from "./Shape.astro";
import { alternatePath, type Locale } from "../lib/site";
import type { SiteContent } from "../lib/i18n/types";

type Props = { content: SiteContent["footer"]; locale: Locale };
const { content, locale } = Astro.props;
---

<footer class="footer">
  <svg class="footer-zigzag" viewBox="0 0 1200 26" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0 20 L30 6 L60 20 L90 6 L120 20 L150 6 L180 20 L210 6 L240 20 L270 6 L300 20 L330 6 L360 20 L390 6 L420 20 L450 6 L480 20 L510 6 L540 20 L570 6 L600 20 L630 6 L660 20 L690 6 L720 20 L750 6 L780 20 L810 6 L840 20 L870 6 L900 20 L930 6 L960 20 L990 6 L1020 20 L1050 6 L1080 20 L1110 6 L1140 20 L1170 6 L1200 20"
      fill="none"
      stroke="currentColor"
      stroke-width="5"
      stroke-linejoin="round"
    />
  </svg>
  <div class="wrap footer-inner">
    <span class="footer-tag">
      <Shape kind="circle" color="pink" size={14} />
      {content.tagline}
    </span>
    <p class="footer-built">{content.built}</p>
    <nav class="footer-links" aria-label="footer">
      {content.links.map((link) => (
        <a href={link.href} rel="noopener">{link.label}</a>
      ))}
      <a class="nav-locale" href={alternatePath(locale)}>{content.localeSwitch}</a>
    </nav>
    <p class="footer-colophon">{content.colophon}</p>
  </div>
</footer>
