---
import SiteLayout from "../layouts/SiteLayout.astro";
import ShapeNav from "../components/ShapeNav.astro";
import HeroStage from "../components/HeroStage.astro";
import PipelineBlocks from "../components/PipelineBlocks.astro";
import AssetCarousel from "../components/AssetCarousel.astro";
import PlayRules from "../components/PlayRules.astro";
import CtaConfetti from "../components/CtaConfetti.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getContent } from "../lib/site";

const t = getContent("zh");
---

<SiteLayout title={t.meta.title} description={t.meta.description} locale="zh">
  <ShapeNav content={t.nav} locale="zh" />
  <main>
    <HeroStage content={t.hero} />
    <PipelineBlocks content={t.pipeline} />
    <AssetCarousel content={t.carousel} />
    <PlayRules content={t.rules} />
    <CtaConfetti content={t.cta} />
  </main>
  <SiteFooter content={t.footer} locale="zh" />
</SiteLayout>
