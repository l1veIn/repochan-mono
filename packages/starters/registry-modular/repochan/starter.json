{
  "schemaVersion": "repochan.starter.v1",
  "id": "registry-modular",
  "name": "Registry Modular",
  "description": "A seven-section editorial registry with a composited Hero, live modular sections, and hard-cut seal transitions.",
  "style": "constructivist-registry",
  "tags": ["landing", "multi-section", "modular", "html-first"],
  "default": false,
  "config": {
    "site": "repochan/site.json",
    "assets": "repochan/assets.json",
    "i18nDir": "repochan/i18n"
  },
  "content": {
    "defaultLocale": "en",
    "supportedLocales": ["en", "zh"],
    "requiredPaths": [
      "meta.title",
      "meta.description",
      "content.nav.ariaLabel",
      "content.nav.brand",
      "content.nav.menuLabel",
      "content.nav.links.0.label",
      "content.nav.links.0.href",
      "content.nav.links.1.label",
      "content.nav.links.1.href",
      "content.nav.links.2.label",
      "content.nav.links.2.href",
      "content.nav.links.3.label",
      "content.nav.links.3.href",
      "content.nav.localeLabel",
      "content.nav.localeHref",
      "content.hero.ariaLabel",
      "content.hero.eyebrow",
      "content.hero.headline",
      "content.hero.body",
      "content.hero.primaryCta.label",
      "content.hero.primaryCta.href",
      "content.hero.secondaryCta.label",
      "content.hero.secondaryCta.href",
      "content.capabilities.eyebrow",
      "content.capabilities.title",
      "content.capabilities.items.0.title",
      "content.capabilities.items.0.body",
      "content.capabilities.items.0.icon",
      "content.capabilities.items.1.title",
      "content.capabilities.items.1.body",
      "content.capabilities.items.1.icon",
      "content.capabilities.items.2.title",
      "content.capabilities.items.2.body",
      "content.capabilities.items.2.icon",
      "content.capabilities.items.3.title",
      "content.capabilities.items.3.body",
      "content.capabilities.items.3.icon",
      "content.capabilities.items.4.title",
      "content.capabilities.items.4.body",
      "content.capabilities.items.4.icon",
      "content.capabilities.items.5.title",
      "content.capabilities.items.5.body",
      "content.capabilities.items.5.icon",
      "content.workflow.eyebrow",
      "content.workflow.title",
      "content.workflow.steps.0.title",
      "content.workflow.steps.0.body",
      "content.workflow.steps.1.title",
      "content.workflow.steps.1.body",
      "content.workflow.steps.2.title",
      "content.workflow.steps.2.body",
      "content.workflow.steps.3.title",
      "content.workflow.steps.3.body",
      "content.workflow.aside",
      "content.proof.eyebrow",
      "content.proof.items.0.lead",
      "content.proof.items.0.emphasis",
      "content.proof.items.0.tail",
      "content.proof.items.1.lead",
      "content.proof.items.1.emphasis",
      "content.proof.items.1.tail",
      "content.proof.items.2.lead",
      "content.proof.items.2.emphasis",
      "content.proof.items.2.tail",
      "content.proof.items.3.lead",
      "content.proof.items.3.emphasis",
      "content.proof.items.3.tail",
      "content.cta.headline",
      "content.cta.body",
      "content.cta.primary.label",
      "content.cta.primary.href",
      "content.cta.secondary.label",
      "content.cta.secondary.href",
      "content.footer.summary",
      "content.footer.groups.0.title",
      "content.footer.groups.0.links.0.label",
      "content.footer.groups.0.links.0.href",
      "content.footer.groups.0.links.1.label",
      "content.footer.groups.0.links.1.href",
      "content.footer.groups.1.title",
      "content.footer.groups.1.links.0.label",
      "content.footer.groups.1.links.0.href",
      "content.footer.groups.1.links.1.label",
      "content.footer.groups.1.links.1.href",
      "content.footer.groups.2.title",
      "content.footer.groups.2.links.0.label",
      "content.footer.groups.2.links.0.href",
      "content.footer.legal"
    ]
  },
  "capabilities": {
    "sections": [
      {
        "id": "nav",
        "required": true,
        "recipe": "html-first-utility-nav",
        "provenance": { "type": "html-first" },
        "bakedLayers": [],
        "liveLayers": ["L1", "L3", "L4"],
        "canonicalViewport": { "width": 1440, "height": 76 },
        "responsive": {
          "mode": "reflow",
          "notes": "Collapse links into a native details menu while preserving locale and brand controls."
        },
        "motion": ["interactive"]
      },
      {
        "id": "hero",
        "required": true,
        "recipe": "registry-hero-composite-live-copy",
        "provenance": {
          "type": "design-reference",
          "reference": "public/references/hero.svg"
        },
        "bakedLayers": ["L1c", "L2"],
        "liveLayers": ["L1a", "L3", "L4"],
        "canonicalViewport": { "width": 1440, "height": 824 },
        "safeZones": [
          { "id": "live-copy", "x": 0.04, "y": 0.16, "width": 0.44, "height": 0.68 },
          { "id": "character-face", "x": 0.62, "y": 0.12, "width": 0.24, "height": 0.28 }
        ],
        "responsive": {
          "mode": "recompose",
          "notes": "Place live copy before the full-width artwork and preserve the character face, both CTAs, and reading order on narrow screens."
        },
        "assetSlots": ["hero-composite"],
        "motion": ["ambient"]
      },
      {
        "id": "capabilities",
        "required": true,
        "recipe": "live-registry-card-grid",
        "provenance": {
          "type": "design-reference",
          "reference": "public/references/capabilities.svg"
        },
        "bakedLayers": [],
        "liveLayers": ["L1", "L3", "L4"],
        "canonicalViewport": { "width": 1440, "height": 920 },
        "responsive": {
          "mode": "reflow",
          "notes": "Reflow three columns to two and then one without changing content order."
        },
        "motion": ["ambient"]
      },
      {
        "id": "workflow",
        "required": true,
        "recipe": "live-arched-process-rail",
        "provenance": {
          "type": "design-reference",
          "reference": "public/references/workflow.svg"
        },
        "bakedLayers": [],
        "liveLayers": ["L1", "L3", "L4"],
        "canonicalViewport": { "width": 1440, "height": 820 },
        "responsive": {
          "mode": "reflow",
          "notes": "Reflow the four-step rail to two columns and then one; remove directional arrows when the rail wraps."
        },
        "motion": ["ambient"]
      },
      {
        "id": "proof",
        "required": true,
        "recipe": "live-proof-register",
        "provenance": {
          "type": "design-reference",
          "reference": "public/references/proof.svg"
        },
        "bakedLayers": [],
        "liveLayers": ["L1", "L3"],
        "canonicalViewport": { "width": 1440, "height": 560 },
        "responsive": {
          "mode": "reflow",
          "notes": "Reflow four proof statements to two and then one while keeping each claim independently readable."
        },
        "motion": ["ambient"]
      },
      {
        "id": "cta",
        "required": true,
        "recipe": "live-arch-cta",
        "provenance": {
          "type": "design-reference",
          "reference": "public/references/cta.svg"
        },
        "bakedLayers": [],
        "liveLayers": ["L1", "L3", "L4"],
        "canonicalViewport": { "width": 1440, "height": 672 },
        "safeZones": [
          { "id": "centered-copy", "x": 0.22, "y": 0.18, "width": 0.56, "height": 0.58 }
        ],
        "responsive": {
          "mode": "reflow",
          "notes": "Stack actions at narrow widths and crop decorative arches without colliding with live copy."
        },
        "motion": ["ambient", "interactive"]
      },
      {
        "id": "footer",
        "required": true,
        "recipe": "html-first-link-register",
        "provenance": { "type": "html-first" },
        "bakedLayers": [],
        "liveLayers": ["L1", "L3", "L4"],
        "canonicalViewport": { "width": 1440, "height": 440 },
        "responsive": {
          "mode": "reflow",
          "notes": "Stack the project summary before link groups and retain visible keyboard focus."
        },
        "motion": ["interactive"]
      }
    ],
    "transitions": [
      {
        "from": "nav",
        "to": "hero",
        "kind": "hard-cut",
        "mobile": "Keep the border cut and remove no content."
      },
      {
        "from": "hero",
        "to": "capabilities",
        "kind": "motif-handoff",
        "motif": "centered-seal",
        "direction": "down",
        "mobile": "Keep one centered seal; disable continuous rotation under reduced motion."
      },
      {
        "from": "capabilities",
        "to": "workflow",
        "kind": "motif-handoff",
        "motif": "centered-seal",
        "direction": "down",
        "mobile": "Keep one centered seal between the stacked sections."
      },
      {
        "from": "workflow",
        "to": "proof",
        "kind": "motif-handoff",
        "motif": "centered-seal",
        "direction": "down",
        "mobile": "Keep one centered seal and hide process arrows."
      },
      {
        "from": "proof",
        "to": "cta",
        "kind": "motif-handoff",
        "motif": "centered-seal",
        "direction": "down",
        "mobile": "Keep one centered seal above the CTA."
      },
      {
        "from": "cta",
        "to": "footer",
        "kind": "hard-cut",
        "mobile": "Preserve the high-contrast border and stack the footer groups."
      }
    ]
  },
  "assets": [
    {
      "slot": "hero-composite",
      "required": true,
      "reference": "public/references/hero.svg",
      "output": "public/assets/hero-composite.webp",
      "description": "A text-free 16:9 composition with the project character on the right and quiet live-copy space on the left.",
      "order": {
        "assetType": "hero_composite",
        "templateId": "official/hero-character-migrate",
        "brief": {
          "mustInclude": [
            "preserve the registry composition and centered transition anchor",
            "keep the left 44 percent quiet for live HTML copy",
            "keep the project foundation character face visible in the upper-right safe zone"
          ],
          "avoid": ["rendered text", "logos", "UI controls", "project metrics"],
          "creativeFreedom": ["lighting", "local atmosphere", "project-specific geometric motifs"]
        },
        "deliverables": [
          {
            "name": "hero-composite",
            "format": "png",
            "width": 2560,
            "height": 1440,
            "aspectRatio": "16:9"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": { "format": "webp", "quality": 82, "maxWidth": 2560 },
          "out": "public/assets/hero-composite.webp"
        }
      ]
    }
  ]
}
