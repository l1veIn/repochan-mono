{
  "schemaVersion": "repochan.starter.v1",
  "id": "landing-glitch-os",
  "name": "故障桌面 · Glitch OS Desktop",
  "description": "RepoChan's own glitch-OS landing page: a malfunctioning retro computer desktop that renders your repo into a mascot — boot splash, icon desktop with a die-cut hero cutout, four stacked live windows (terminal analysis / persona field sheet / asset grid / foundation FILE-OK), a fake-BSOD success modal and a taskbar with pipeline chips. zh default locale with a full en edition; every bitmap is real pipeline output.",
  "style": "glitch-os-desktop",
  "tags": [
    "landing",
    "glitch",
    "os-desktop",
    "crt",
    "terminal",
    "retro",
    "bilingual"
  ],
  "previews": {
    "desktop": "repochan/previews/desktop.webp",
    "mobile": "repochan/previews/mobile.webp"
  },
  "config": {
    "site": "repochan/site.json",
    "assets": "repochan/assets.json",
    "i18nDir": "repochan/i18n"
  },
  "content": {
    "defaultLocale": "zh",
    "supportedLocales": [
      "zh",
      "en"
    ]
  },
  "assets": [
    {
      "kind": "scalar",
      "slot": "cutout-a",
      "required": true,
      "reference": "repochan/references/cutout-a-matte.png",
      "output": "public/assets/cutout-a.webp",
      "description": "Full-body die-cut cutout A (handing-a-stylus pose) — the desktop hero visual leaning against the icon column, transparent webp produced by chroma-key + compress. Reference is the raw matte master (2:3).",
      "order": {
        "assetType": "character_cutout",
        "templateId": "official/character-cutout",
        "brief": {
          "intent": "Regenerate the desktop-hero cutout for the downstream project's character, keeping the reference matte's full-body framing and friendly presenting/handing energy so it can stand on a desktop next to the icon column.",
          "mustInclude": [
            "one full-body character in a friendly presenting or handing-over pose, fully inside the canvas",
            "perfectly flat uniform matte background in a color absent from the character",
            "vertical 2:3 framing, character centered"
          ],
          "avoid": [
            "text",
            "letters",
            "scenery",
            "shadows on the matte",
            "cropped limbs or props"
          ],
          "creativeFreedom": [
            "character outfit details",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "cutout-matte",
            "format": "png",
            "width": 1024,
            "height": 1536,
            "aspectRatio": "2:3",
            "genSize": "2048x3072"
          }
        ]
      },
      "postprocess": [
        {
          "op": "chroma-key",
          "args": {
            "matte": "auto",
            "pipeline": "v2"
          },
          "out": "public/assets/cutout-a.png"
        },
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 88
          },
          "out": "public/assets/cutout-a.webp"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "cutout-b",
      "required": true,
      "reference": "repochan/references/cutout-b-matte.png",
      "output": "public/assets/cutout-b.webp",
      "description": "Full-body die-cut cutout B (reaching-out inviting pose) — the persona window's avatar, displayed with CSS RGB-split glitch slices; transparent webp produced by chroma-key + compress. Reference is the raw matte master (1:1).",
      "order": {
        "assetType": "character_cutout",
        "templateId": "official/character-cutout",
        "brief": {
          "intent": "Regenerate the persona-avatar cutout for the downstream project's character: a welcoming reaching-out pose that still reads when duplicated into offset RGB glitch slices.",
          "mustInclude": [
            "one full-body character reaching out or waving an invitation, fully inside the canvas",
            "perfectly flat uniform matte background in a color absent from the character",
            "square 1:1 framing, character centered"
          ],
          "avoid": [
            "text",
            "letters",
            "scenery",
            "shadows on the matte",
            "cropped limbs or props"
          ],
          "creativeFreedom": [
            "character outfit details",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "cutout-matte",
            "format": "png",
            "width": 1024,
            "height": 1024,
            "aspectRatio": "1:1",
            "genSize": "2048x2048"
          }
        ]
      },
      "postprocess": [
        {
          "op": "chroma-key",
          "args": {
            "matte": "auto",
            "pipeline": "v2"
          },
          "out": "public/assets/cutout-b.png"
        },
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 88
          },
          "out": "public/assets/cutout-b.webp"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "foundation",
      "required": true,
      "reference": "repochan/references/foundation.png",
      "description": "Character foundation sheet — the foundation window's evidence image (key visual, expressions, palette, props), served as JPEG q85. Reference is the raw generated master (1:1); also the page's og:image.",
      "output": "public/assets/foundation.jpg",
      "order": {
        "assetType": "foundation_sheet",
        "templateId": "official/foundation-sheet",
        "brief": {
          "intent": "Regenerate the downstream project character's foundation sheet — the consistency baseline every other order references — so the foundation window can show it as locked evidence.",
          "mustInclude": [
            "one foundation sheet for the project character: key visual, expression set, color palette and key props",
            "square 1:1 framing with every panel fully inside the canvas"
          ],
          "avoid": [
            "watermarks",
            "rendered paragraphs of text",
            "panels cropped by the canvas edge"
          ],
          "creativeFreedom": [
            "panel layout",
            "expression and prop selection within the persona"
          ]
        },
        "deliverables": [
          {
            "name": "foundation",
            "format": "png",
            "width": 1024,
            "height": 1024,
            "aspectRatio": "1:1",
            "genSize": "1024x1024"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": {
            "format": "jpeg",
            "quality": 85
          },
          "out": "public/assets/foundation.jpg"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "icon",
      "required": true,
      "output": "public/assets/icon.webp",
      "description": "Project icon — taskbar start badge; also the favicon source (favicon.ico / apple-touch-icon.png / icon-192.png / icon-512.png are derived from it offline via compress + favicon + resize).",
      "order": {
        "assetType": "icon",
        "templateId": "official/icon-single",
        "brief": {
          "mustInclude": [
            "one scalable brand mark reading cleanly at 22px in a taskbar",
            "project motif without any letterforms"
          ],
          "avoid": [
            "text",
            "letters",
            "watermarks"
          ],
          "creativeFreedom": [
            "mark geometry",
            "accent colors from the project palette"
          ]
        },
        "deliverables": [
          {
            "name": "icon",
            "format": "png",
            "width": 512,
            "height": 512,
            "aspectRatio": "1:1",
            "genSize": "1024x1024"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 90,
            "maxWidth": 512
          },
          "out": "public/assets/icon.webp"
        }
      ]
    },
    {
      "kind": "bundle",
      "slot": "stickers",
      "required": true,
      "reference": "repochan/references/stickers-grid.png",
      "publications": [
        {
          "key": "welcome",
          "cell": 0,
          "output": "public/assets/stickers/sticker-0.webp"
        },
        {
          "key": "searching",
          "cell": 1,
          "output": "public/assets/stickers/sticker-1.webp"
        },
        {
          "key": "loading",
          "cell": 2,
          "output": "public/assets/stickers/sticker-2.webp"
        },
        {
          "key": "empty",
          "cell": 3,
          "output": "public/assets/stickers/sticker-3.webp"
        },
        {
          "key": "error",
          "cell": 4,
          "output": "public/assets/stickers/sticker-4.webp"
        },
        {
          "key": "success",
          "cell": 5,
          "output": "public/assets/stickers/sticker-5.webp"
        },
        {
          "key": "not-found",
          "cell": 6,
          "output": "public/assets/stickers/sticker-6.webp"
        },
        {
          "key": "cta",
          "cell": 7,
          "output": "public/assets/stickers/sticker-7.webp"
        },
        {
          "key": "cozy",
          "cell": 8,
          "output": "public/assets/stickers/sticker-8.webp"
        }
      ],
      "description": "Nine die-cut chibi stickers — the painter window's sticker tile grid (all nine cells, checkerboard backing shows transparency). sticker-N.webp is cell N of the 3×3 grid; the source grid's cell semantics (chibi expressions) differ from the template's fixed keys, and the keys are the positional replacement contract for downstream regeneration.",
      "order": {
        "assetType": "web_state_stickers",
        "templateId": "official/web-state-grid-3x3",
        "brief": {
          "mustInclude": [
            "strict 3×3 grid of the project character in the nine fixed web-state poses (template cell semantics)",
            "perfectly flat uniform matte background in a color absent from the character, identical in every pixel outside the stickers"
          ],
          "avoid": [
            "text",
            "letters",
            "numbers",
            "borders",
            "grid lines",
            "scenery",
            "shadows on the matte"
          ],
          "creativeFreedom": [
            "expression and pose details inside each fixed semantic",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "sticker-grid",
            "format": "png",
            "width": 1024,
            "height": 1024,
            "aspectRatio": "1:1",
            "genSize": "2048x2048"
          }
        ]
      },
      "postprocess": [
        {
          "op": "extract-grid",
          "args": {
            "rows": 3,
            "cols": 3,
            "strategy": "chroma-grid",
            "mapping": {
              "welcome": 0,
              "searching": 1,
              "loading": 2,
              "empty": 3,
              "error": 4,
              "success": 5,
              "not-found": 6,
              "cta": 7,
              "cozy": 8
            },
            "normalize": {
              "canvasSize": 640,
              "padding": 10
            },
            "chroma": {
              "matteColor": "auto",
              "pipeline": "v2",
              "matteSelect": "subject-aware"
            },
            "geometry": {
              "mode": "centroid-components"
            },
            "qa": {
              "alphaThreshold": 32,
              "minForegroundRatio": 0.05,
              "maxForegroundRatio": 0.9,
              "maxSheetEdgeTouchRatio": 0.05
            },
            "format": "webp",
            "quality": 80
          },
          "out": "public/assets/stickers"
        }
      ]
    },
    {
      "kind": "bundle",
      "slot": "webstates",
      "required": true,
      "reference": "repochan/references/webstates-grid.png",
      "publications": [
        {
          "key": "welcome",
          "cell": 0,
          "output": "public/assets/webstates/state-0.webp"
        },
        {
          "key": "searching",
          "cell": 1,
          "output": "public/assets/webstates/state-1.webp"
        },
        {
          "key": "loading",
          "cell": 2,
          "output": "public/assets/webstates/state-2.webp"
        },
        {
          "key": "empty",
          "cell": 3,
          "output": "public/assets/webstates/state-3.webp"
        },
        {
          "key": "error",
          "cell": 4,
          "output": "public/assets/webstates/state-4.webp"
        },
        {
          "key": "success",
          "cell": 5,
          "output": "public/assets/webstates/state-5.webp"
        },
        {
          "key": "not-found",
          "cell": 6,
          "output": "public/assets/webstates/state-6.webp"
        },
        {
          "key": "cta",
          "cell": 7,
          "output": "public/assets/webstates/state-7.webp"
        },
        {
          "key": "cozy",
          "cell": 8,
          "output": "public/assets/webstates/state-8.webp"
        }
      ],
      "description": "Web-state chibi illustrations — the painter window's state tile strip. state-N.webp is cell N of the 3×3 grid; the source grid's cell semantics differ from the template's fixed keys, and the keys are the positional replacement contract for downstream regeneration.",
      "order": {
        "assetType": "web_state_stickers",
        "templateId": "official/web-state-grid-3x3",
        "brief": {
          "mustInclude": [
            "strict 3×3 grid of the project character in the nine fixed web-state poses (template cell semantics)",
            "perfectly flat uniform matte background in a color absent from the character, identical in every pixel outside the stickers"
          ],
          "avoid": [
            "text",
            "letters",
            "numbers",
            "borders",
            "grid lines",
            "scenery",
            "shadows on the matte"
          ],
          "creativeFreedom": [
            "pose details inside each fixed semantic",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "webstate-grid",
            "format": "png",
            "width": 1024,
            "height": 1024,
            "aspectRatio": "1:1",
            "genSize": "2048x2048"
          }
        ]
      },
      "postprocess": [
        {
          "op": "extract-grid",
          "args": {
            "rows": 3,
            "cols": 3,
            "strategy": "chroma-grid",
            "mapping": {
              "welcome": 0,
              "searching": 1,
              "loading": 2,
              "empty": 3,
              "error": 4,
              "success": 5,
              "not-found": 6,
              "cta": 7,
              "cozy": 8
            },
            "normalize": {
              "canvasSize": 640,
              "padding": 10
            },
            "chroma": {
              "matteColor": "auto",
              "pipeline": "v2",
              "matteSelect": "subject-aware"
            },
            "geometry": {
              "mode": "centroid-components"
            },
            "qa": {
              "alphaThreshold": 32,
              "minForegroundRatio": 0.05,
              "maxForegroundRatio": 0.9,
              "maxSheetEdgeTouchRatio": 0.1
            },
            "format": "webp",
            "quality": 80
          },
          "out": "public/assets/webstates"
        }
      ]
    }
  ]
}
