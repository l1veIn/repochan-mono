---
import { assets } from "../lib/site";
import type { DesktopContent } from "../lib/i18n/types";

type Props = { content: DesktopContent };
const { content } = Astro.props;

const [analysis, persona, painter, deploy, trash] = content.icons;
---

<header class="desktop" id="desktop">
  <nav class="dsk-icons" aria-label="desktop icons">
    <a class="dsk-icon" href={`#${analysis.id}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="2.5" y="4" width="19" height="16" rx="2" />
        <path d="M6.5 9.5l3 2.5-3 2.5M11.5 15h5" stroke-linecap="round" />
      </svg>
      <span>{analysis.label}</span>
    </a>
    <a class="dsk-icon" href={`#${persona.id}`}>
      <img src={assets.icon.src} width="512" height="512" alt="" loading="eager" />
      <span>{persona.label}</span>
    </a>
    <a class="dsk-icon" href={`#${painter.id}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="9" cy="9" r="1.8" />
        <path d="M21 15.5l-5-5L5.5 21" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{painter.label}</span>
    </a>
    <a class="dsk-icon" href={`#${deploy.id}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M12 3l7 7h-4v7h-6v-7H5l7-7z" stroke-linejoin="round" />
        <path d="M5 21h14" stroke-linecap="round" />
      </svg>
      <span>{deploy.label}</span>
    </a>
    <span class="dsk-icon dsk-icon--deco" title={trash.note}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 7h16M9.5 7V5h5v2M6.5 7l1 13h9l1-13" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{trash.label}</span>
    </span>
  </nav>

  <div class="dsk-brand">
    <p class="dsk-brand__ver mono">{content.version}</p>
    <h1><span class="glitch-text" data-text={content.brand}>{content.brand}</span></h1>
    <p class="dsk-brand__tag">{content.tagline}</p>
    <p class="dsk-brand__sub">{content.sub}</p>
    <p class="dsk-brand__hint">{content.hint}</p>
  </div>

  <figure class="dsk-hero glitch-fig">
    <img src={assets.cutoutA.src} width={assets.cutoutA.width} height={assets.cutoutA.height} alt={content.heroAlt} loading="eager" />
    <span class="glitch-fig__slice glitch-fig__slice--hot" aria-hidden="true">
      <img src={assets.cutoutA.src} alt="" loading="eager" />
    </span>
    <span class="glitch-fig__slice glitch-fig__slice--cyan" aria-hidden="true">
      <img src={assets.cutoutA.src} alt="" loading="eager" />
    </span>
  </figure>
</header>
