    "notes": {
      "kicker": "Studio Notes",
      "title": "流水线笔记",
      "intro": "每一件展品背后是同一条六步流水线。命令即展品说明。",
      "steps": [
        {
          "title": "分析仓库",
          "desc": "README、代码结构、提交历史，全部翻成设计证据。",
          "command": "repochan analysis"
        },
        {
          "title": "灵魂访谈",
          "desc": "结构化问题，问出项目的语气、受众与分量。",
          "command": "repochan interview create"
        },
        {
          "title": "生成人设",
          "desc": "三个智能体协作，捏出有生命力的看板娘。",
          "command": "repochan persona create"
        },
        {
          "title": "开创作订单",
          "desc": "美术总监一次开齐全部 Asset Orders，设定集优先。",
          "command": "repochan order create"
        },
        {
          "title": "画师出图",
          "desc": "按订单生成设定集、贴纸、海报；不满意就重画，旧版自动成为历史。",
          "command": "repochan image gen"
        },
        {
          "title": "装配成站",
          "desc": "资产装进落地页，开幕——就像你现在站着的这间美术馆。",
          "command": "repochan starter pull"
        }
      ]
