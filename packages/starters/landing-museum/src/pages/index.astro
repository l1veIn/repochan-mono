---
import SiteLayout from "../layouts/SiteLayout.astro";
import MuseumNav from "../components/MuseumNav.astro";
import Lobby from "../components/Lobby.astro";
import GalleryFoundation from "../components/GalleryFoundation.astro";
import GalleryStudies from "../components/GalleryStudies.astro";
import GalleryEditions from "../components/GalleryEditions.astro";
import GalleryPosters from "../components/GalleryPosters.astro";
import StudioNotes from "../components/StudioNotes.astro";
import MuseumShop from "../components/MuseumShop.astro";
import Colophon from "../components/Colophon.astro";
import { getContent } from "../lib/site";

const t = getContent("zh");
---

<SiteLayout title={t.meta.title} description={t.meta.description} locale="zh" lightbox={t.lightbox}>
  <MuseumNav content={t.nav} locale="zh" command={t.lobby.ctaPrimaryCommand} copied={t.lobby.copied} />
  <main>
    <Lobby content={t.lobby} />
    <GalleryFoundation content={t.galleryA} />
    <GalleryStudies content={t.galleryB} />
    <GalleryEditions content={t.galleryC} />
    <GalleryPosters content={t.galleryD} />
    <StudioNotes content={t.notes} />
    <MuseumShop content={t.shop} />
  </main>
  <Colophon content={t.colophon} locale="zh" />
</SiteLayout>
