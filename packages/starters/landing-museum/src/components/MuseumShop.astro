---
import type { SiteContent } from "../lib/i18n/types";

type Props = { content: SiteContent["shop"] };
const { content } = Astro.props;
---

<section class="room" id="shop">
  <p class="room-kicker" data-reveal>{content.kicker}</p>
  <h2 class="room-title" data-reveal style="--d:60ms">{content.title}</h2>
  <p class="room-intro" data-reveal style="--d:120ms">{content.intro}</p>

  <div class="shop-grid">
    {
      content.cards.map((card, i) => (
        <article class="shop-card" data-reveal style={`--d:${i * 70}ms`}>
          <h3 class="shop-title">{card.title}</h3>
          <p class="shop-desc">{card.desc}</p>
          <div class="shop-command-row">
            <code>{card.command}</code>
            <button
              class="shop-copy"
              type="button"
              data-copy={card.command}
              data-copied={content.copiedLabel}
            >
              {content.copyLabel}
            </button>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3.5vw, 48px);
  }

  .shop-card {
    background: var(--mat);
    border: 1px solid var(--hairline);
    padding: clamp(24px, 3vw, 36px);
    box-shadow: 0 18px 36px -26px color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .shop-title {
    font-family: "Newsreader", "Noto Serif SC", serif;
    font-size: 21px;
    font-weight: 500;
  }

  .shop-desc {
    font-size: 14px;
    color: var(--muted);
    margin-top: 8px;
    min-height: 3.4em;
  }

  .shop-command-row {
    margin-top: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--hairline);
    padding-top: 16px;
  }

  .shop-command-row code {
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .shop-copy {
    flex-shrink: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    border: 1px solid var(--ink);
    padding: 6px 12px;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .shop-copy:hover,
  .shop-copy.is-copied {
    background: var(--ink);
    color: var(--wall);
  }

  @media (max-width: 900px) {
    .shop-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }
</style>
