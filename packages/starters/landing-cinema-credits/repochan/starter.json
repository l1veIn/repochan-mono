{
  "schemaVersion": "repochan.starter.v1",
  "id": "landing-cinema-credits",
  "name": "影院片头 · Cinema Opening Credits",
  "description": "RepoChan's own cinema-opening-credits landing page: a theatrical black-void screening under a constant letterbox frame — studio card, title card, a spotlight-swept starring cutout, a scrolling cast & crew roll mapping the multi-agent skills to film roles, three real scene stills, a tagline card, a lights-up end-card CTA and a post-credits sticker gag. zh default locale with a full en edition; every visual is real pipeline output.",
  "style": "cinema-opening-credits",
  "tags": [
    "landing",
    "cinema",
    "opening-credits",
    "letterbox",
    "credit-roll",
    "theatrical",
    "bilingual"
  ],
  "previews": {
    "desktop": "repochan/previews/desktop.webp",
    "mobile": "repochan/previews/mobile.webp"
  },
  "config": {
    "site": "repochan/site.json",
    "assets": "repochan/assets.json",
    "i18nDir": "repochan/i18n"
  },
  "content": {
    "defaultLocale": "zh",
    "supportedLocales": [
      "zh",
      "en"
    ]
  },
  "assets": [
    {
      "kind": "scalar",
      "slot": "star-cutout",
      "required": true,
      "reference": "repochan/references/star-cutout-matte.webp",
      "output": "public/assets/star-cutout.webp",
      "description": "Full-body die-cut cutout of the starring character — the starring card's main visual under the CSS spotlight sweep, transparent webp produced by chroma-key + compress. Reference is the raw matte master (2:3).",
      "order": {
        "assetType": "character_cutout",
        "templateId": "official/character-cutout",
        "brief": {
          "intent": "Regenerate the starring-card cutout for the downstream project's character, keeping the reference matte's full-body framing and confident presenting energy so it can stand alone on a black stage under a spotlight.",
          "mustInclude": [
            "one full-body character in a confident presenting pose, fully inside the canvas",
            "perfectly flat uniform matte background in a color absent from the character",
            "vertical 2:3 framing, character centered"
          ],
          "avoid": [
            "text",
            "letters",
            "scenery",
            "shadows on the matte",
            "cropped limbs or props"
          ],
          "creativeFreedom": [
            "character outfit details",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "cutout-matte",
            "format": "png",
            "width": 1024,
            "height": 1536,
            "aspectRatio": "2:3",
            "genSize": "2048x3072"
          }
        ]
      },
      "postprocess": [
        {
          "op": "chroma-key",
          "args": {
            "matte": "auto",
            "pipeline": "v2"
          },
          "out": "public/assets/star-cutout.png"
        },
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 88
          },
          "out": "public/assets/star-cutout.webp"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "still-foundation",
      "required": true,
      "output": "public/assets/stills/foundation.jpg",
      "description": "Character foundation sheet — scene still 01 (key visual, expressions, palette, props), served as JPEG q85; also the page's og:image.",
      "order": {
        "assetType": "foundation_sheet",
        "templateId": "official/foundation-sheet",
        "brief": {
          "intent": "Regenerate the downstream project character's foundation sheet — the consistency baseline every other order references — so it can run as scene still 01 in the credits sequence.",
          "mustInclude": [
            "one foundation sheet for the project character: key visual, expression set, color palette and key props",
            "square 1:1 framing with every panel fully inside the canvas"
          ],
          "avoid": [
            "watermarks",
            "rendered paragraphs of text",
            "panels cropped by the canvas edge"
          ],
          "creativeFreedom": [
            "panel layout",
            "expression and prop selection within the persona"
          ]
        },
        "deliverables": [
          {
            "name": "foundation",
            "format": "png",
            "width": 1200,
            "height": 1200,
            "aspectRatio": "1:1",
            "genSize": "2048x2048"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": {
            "format": "jpeg",
            "quality": 85,
            "maxWidth": 1200
          },
          "out": "public/assets/stills/foundation.jpg"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "still-studio",
      "required": true,
      "output": "public/assets/stills/studio-wide.webp",
      "description": "Studio wide shot — scene still 02: the production pipeline on camera, landscape 3:2 edge-to-edge scene served as webp.",
      "order": {
        "assetType": "poster",
        "templateId": "official/poster-scene",
        "brief": {
          "intent": "Repaint the studio wide shot for the downstream project's own character and world — the production floor where the film's assets are drawn — as scene still 02.",
          "mustInclude": [
            "the downstream character working at her workspace inside her studio",
            "walls with pinned artwork, a window with a city skyline, dusk mood with one warm desk lamp",
            "landscape 3:2 edge-to-edge scene"
          ],
          "avoid": [
            "rendered text",
            "letters",
            "numbers",
            "signage",
            "watermarks",
            "UI baked into the image"
          ],
          "creativeFreedom": [
            "world-specific props and posters (without legible text)",
            "lighting and palette from the project identity"
          ]
        },
        "deliverables": [
          {
            "name": "studio-wide",
            "format": "png",
            "width": 1536,
            "height": 1024,
            "aspectRatio": "3:2",
            "genSize": "2304x1536"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 80,
            "maxWidth": 1536
          },
          "out": "public/assets/stills/studio-wide.webp"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "still-poster",
      "required": true,
      "output": "public/assets/stills/poster.jpg",
      "description": "Promotional poster — scene still 03: the project character with the brand key visual, landscape 3:2 served as JPEG q82.",
      "order": {
        "assetType": "poster",
        "templateId": "official/poster",
        "brief": {
          "intent": "Repaint the promotional poster for the downstream project: the project character with the brand key visual, composed as the film's one-sheet and run as scene still 03.",
          "mustInclude": [
            "poster composition featuring the project character",
            "landscape 3:2 framing fully inside the canvas"
          ],
          "avoid": [
            "watermarks",
            "rendered text",
            "UI baked into the image"
          ],
          "creativeFreedom": [
            "scene, mood and composition that support the project identity",
            "lighting and palette from the project identity"
          ]
        },
        "deliverables": [
          {
            "name": "poster",
            "format": "png",
            "width": 1536,
            "height": 1024,
            "aspectRatio": "3:2",
            "genSize": "2304x1536"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": {
            "format": "jpeg",
            "quality": 82,
            "maxWidth": 1536
          },
          "out": "public/assets/stills/poster.jpg"
        }
      ]
    },
    {
      "kind": "scalar",
      "slot": "icon",
      "required": true,
      "output": "public/assets/icon.webp",
      "description": "Project icon — the end card's logo; also the favicon source (favicon.ico / apple-touch-icon.png / icon-192.png / icon-512.png are derived from it offline via compress + favicon + resize).",
      "order": {
        "assetType": "icon",
        "templateId": "official/icon-single",
        "brief": {
          "mustInclude": [
            "one scalable brand mark reading cleanly at 96px on a black end card",
            "project motif without any letterforms"
          ],
          "avoid": [
            "text",
            "letters",
            "watermarks"
          ],
          "creativeFreedom": [
            "mark geometry",
            "accent colors from the project palette"
          ]
        },
        "deliverables": [
          {
            "name": "icon",
            "format": "png",
            "width": 512,
            "height": 512,
            "aspectRatio": "1:1",
            "genSize": "1024x1024"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": {
            "format": "webp",
            "quality": 90,
            "maxWidth": 512
          },
          "out": "public/assets/icon.webp"
        }
      ]
    },
    {
      "kind": "bundle",
      "slot": "webstates",
      "required": true,
      "reference": "repochan/references/webstates-grid.webp",
      "publications": [
        {
          "key": "welcome",
          "cell": 0,
          "output": "public/assets/webstates/state-0.webp"
        },
        {
          "key": "searching",
          "cell": 1,
          "output": "public/assets/webstates/state-1.webp"
        },
        {
          "key": "loading",
          "cell": 2,
          "output": "public/assets/webstates/state-2.webp"
        },
        {
          "key": "empty",
          "cell": 3,
          "output": "public/assets/webstates/state-3.webp"
        },
        {
          "key": "error",
          "cell": 4,
          "output": "public/assets/webstates/state-4.webp"
        },
        {
          "key": "success",
          "cell": 5,
          "output": "public/assets/webstates/state-5.webp"
        },
        {
          "key": "not-found",
          "cell": 6,
          "output": "public/assets/webstates/state-6.webp"
        },
        {
          "key": "cta",
          "cell": 7,
          "output": "public/assets/webstates/state-7.webp"
        },
        {
          "key": "cozy",
          "cell": 8,
          "output": "public/assets/webstates/state-8.webp"
        }
      ],
      "description": "Web-state chibi illustrations; the post-credits gag runs cell 1 (searching) as its sticker. state-N.webp is cell N of the 3×3 grid; the source grid's cell semantics differ from the template's fixed keys, and the keys are the positional replacement contract for downstream regeneration.",
      "order": {
        "assetType": "web_state_stickers",
        "templateId": "official/web-state-grid-3x3",
        "brief": {
          "mustInclude": [
            "strict 3×3 grid of the project character in the nine fixed web-state poses (template cell semantics)",
            "perfectly flat uniform matte background in a color absent from the character, identical in every pixel outside the stickers"
          ],
          "avoid": [
            "text",
            "letters",
            "numbers",
            "borders",
            "grid lines",
            "scenery",
            "shadows on the matte"
          ],
          "creativeFreedom": [
            "pose details inside each fixed semantic",
            "matte color choice"
          ]
        },
        "deliverables": [
          {
            "name": "webstate-grid",
            "format": "png",
            "width": 1024,
            "height": 1024,
            "aspectRatio": "1:1",
            "genSize": "2048x2048"
          }
        ]
      },
      "postprocess": [
        {
          "op": "extract-grid",
          "args": {
            "rows": 3,
            "cols": 3,
            "strategy": "chroma-grid",
            "mapping": {
              "welcome": 0,
              "searching": 1,
              "loading": 2,
              "empty": 3,
              "error": 4,
              "success": 5,
              "not-found": 6,
              "cta": 7,
              "cozy": 8
            },
            "normalize": {
              "canvasSize": 640,
              "padding": 10
            },
            "chroma": {
              "matteColor": "auto",
              "pipeline": "v2",
              "matteSelect": "subject-aware"
            },
            "geometry": {
              "mode": "centroid-components"
            },
            "qa": {
              "alphaThreshold": 32,
              "minForegroundRatio": 0.05,
              "maxForegroundRatio": 0.9,
              "maxSheetEdgeTouchRatio": 0.1
            },
            "format": "webp",
            "quality": 80
          },
          "out": "public/assets/webstates"
        }
      ]
    }
  ]
}
