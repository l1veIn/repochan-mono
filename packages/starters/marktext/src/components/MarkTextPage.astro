---
import en from "../../repochan/i18n/en.json";
import { assets, site } from "../lib/site";

type PageContent = typeof en.content;

type Props = {
  content: PageContent;
  lang: "en" | "zh";
  languageHref: string;
};

const { content, lang, languageHref } = Astro.props;
const galleryItems = content.gallery.items.map((item) => ({
  ...item,
  src: assets[item.asset as keyof typeof assets]?.src,
}));
const primaryGallery = galleryItems.slice(0, 2);
const themeGallery = galleryItems.slice(2);
---

<div
  class="site-shell"
  style={`--hero-image: url(${assets["hero-composite"].src}); --pattern-ink: url(${assets["pattern-ink"].src}); --pattern-deco: url(${assets["pattern-deco"].src});`}
>
  <section class="hero" id="top" aria-label={content.hero.ariaLabel}>
    <div class="hero-media" aria-hidden="true"></div>
    <div class="deco-atmosphere" aria-hidden="true"></div>

    <header class="site-nav" aria-label={content.nav.primaryLabel}>
      <a class="brand" href={lang === "en" ? "/" : "/zh"} aria-label={content.nav.brandLabel}>
        <span class="brand-mark" aria-hidden="true"><span>M</span></span>
        <span>{site.project.name}</span>
      </a>
      <nav class="desktop-nav" aria-label={content.nav.sectionsLabel}>
        <a href="#features">{content.nav.features}</a>
        <a href="#workflow">{content.nav.workflow}</a>
        <a href="#gallery">{content.nav.gallery}</a>
        <a href={content.hero.primaryCta.href}>{content.nav.download}</a>
        <a href={content.hero.secondaryCta.href}>{content.nav.github}</a>
        <a href={languageHref} lang={lang === "en" ? "zh" : "en"}>{content.nav.language}</a>
      </nav>
      <details class="mobile-nav">
        <summary aria-label={content.nav.menu}>{content.nav.menu}</summary>
        <nav aria-label={content.nav.mobileSectionsLabel}>
          <a href="#features">{content.nav.features}</a>
          <a href="#workflow">{content.nav.workflow}</a>
          <a href="#gallery">{content.nav.gallery}</a>
          <a href={content.hero.primaryCta.href}>{content.nav.download}</a>
          <a href={languageHref}>{content.nav.language}</a>
        </nav>
      </details>
    </header>

    <div class="hero-copy">
      <h1>{content.hero.headline}</h1>
      <p>{content.hero.body}</p>
      <div class="button-row">
        <a class="button primary" href={content.hero.primaryCta.href} target="_blank" rel="noreferrer">
          <span aria-hidden="true">↓</span>{content.hero.primaryCta.label}
        </a>
        <a class="button secondary" href={content.hero.secondaryCta.href} target="_blank" rel="noreferrer">
          <span aria-hidden="true">◇</span>{content.hero.secondaryCta.label}
        </a>
      </div>
      <p class="platforms">{content.hero.platforms}</p>
    </div>
    <!-- Spine is line-only here; the diamond lives on the next section's top so it is never painted over. -->
    <div class="spine hero-spine" aria-hidden="true"></div>
  </section>

  <main>
    <section class="paper-section capabilities" id="features" aria-labelledby="capabilities-title">
      <div class="pattern-layer" aria-hidden="true"></div>
      <div class="spine section-spine" aria-hidden="true"><span class="spine-node"></span></div>
      <div class="section-intro">
        <h2 id="capabilities-title">{content.capabilities.title}</h2>
        <p>{content.capabilities.body}</p>
      </div>
      <ol class="capability-list">
        {content.capabilities.items.map((item, index) => (
          <li>
            <span class="index" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
            <span class="row-arrow" aria-hidden="true">›</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="paper-section workflow" id="workflow" aria-labelledby="workflow-title">
      <div class="pattern-layer" aria-hidden="true"></div>
      <!-- Spine is a direct section child so left:var(--spine-x) shares the same origin as other sections. -->
      <div class="spine workflow-spine" aria-hidden="true"><span class="spine-node"></span></div>
      <div class="workflow-intro">
        <h2 id="workflow-title">{content.workflow.title}</h2>
        <p>{content.workflow.body}</p>
      </div>
      <ol class="workflow-steps">
        {content.workflow.steps.map((step, index) => (
          <li>
            <span class="step-index"><span>{String(index + 1).padStart(2, "0")}</span></span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <div class:list={["workflow-pane", `pane-${index + 1}`]} aria-hidden="true">
              <span class="pane-label">
                {[content.workflow.sourceLabel, content.workflow.previewLabel, content.workflow.exportLabel][index]}
              </span>
              <span></span><span></span><span></span><span></span>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="gallery" id="gallery" aria-labelledby="gallery-title">
      <div class="deco-atmosphere gallery-atmosphere" aria-hidden="true"></div>
      <!-- Full-height spine passes *behind* gallery chrome; node sits on the section seam. -->
      <div class="spine gallery-spine" aria-hidden="true">
        <span class="spine-node"></span>
        <span class="spine-branch"></span>
      </div>
      <div class="gallery-head">
        <div class="gallery-copy">
          <p class="eyebrow">{content.gallery.eyebrow}</p>
          <h2 id="gallery-title">{content.gallery.title}</h2>
          <p>{content.gallery.body}</p>
        </div>
        <div class="filter-list" role="tablist" aria-label={content.gallery.tabsLabel}>
          {content.gallery.filters.map((filter, index) => (
            <button
              id={`gallery-tab-${index}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`gallery-panel-${index}`}
              tabindex={index === 0 ? 0 : -1}
            >{filter}</button>
          ))}
        </div>
      </div>

      <div class="gallery-panels">
        {primaryGallery.map((item, index) => (
          <div
            class="gallery-panel primary-gallery"
            id={`gallery-panel-${index}`}
            role="tabpanel"
            aria-labelledby={`gallery-tab-${index}`}
            hidden={index !== 0}
          >
            <figure>
              <div class="screenshot-frame"><img src={item.src} alt={item.label} loading="lazy" /></div>
              <figcaption><strong>{item.label}</strong><span>{item.body}</span></figcaption>
            </figure>
          </div>
        ))}
        <div
          class="gallery-panel theme-panel"
          id="gallery-panel-2"
          role="tabpanel"
          aria-labelledby="gallery-tab-2"
          hidden
        >
          <div class="theme-gallery-wrap">
            <button class="gallery-control previous" type="button" aria-label={content.gallery.previous} aria-controls="theme-gallery">‹</button>
            <div class="theme-gallery" id="theme-gallery" tabindex="0" aria-label={content.gallery.themeScrollerLabel}>
              {themeGallery.map((item) => (
                <figure>
                  <img src={item.src} alt={item.label} loading="lazy" />
                  <figcaption><strong>{item.label}</strong><span>{item.body}</span></figcaption>
                </figure>
              ))}
            </div>
            <button class="gallery-control next" type="button" aria-label={content.gallery.next} aria-controls="theme-gallery">›</button>
          </div>
        </div>
      </div>
    </section>

    <section class="cta" id="download" aria-labelledby="cta-title">
      <div class="pattern-layer" aria-hidden="true"></div>
      <!-- Designed terminus: short vertical run, then L-branch into the ticket. -->
      <div class="spine cta-spine" aria-hidden="true">
        <span class="spine-node"></span>
        <span class="spine-branch spine-branch--ticket"></span>
        <span class="spine-node spine-node--end"></span>
      </div>
      <div class="ticket">
        <div>
          <h2 id="cta-title">{content.cta.title}</h2>
          <p>{content.cta.body}</p>
        </div>
        <div class="cta-actions">
          <div class="button-row">
            <a class="button primary" href={content.cta.primaryCta.href} target="_blank" rel="noreferrer">↓ {content.cta.primaryCta.label}</a>
            <a class="button light" href={content.cta.secondaryCta.href} target="_blank" rel="noreferrer">◇ {content.cta.secondaryCta.label}</a>
          </div>
          <p>{content.cta.platforms}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true"><span>M</span></span>
      <div><strong>{site.project.name}</strong><p>{content.footer.tagline}</p></div>
    </div>
    <a href={site.project.repositoryUrl} target="_blank" rel="noreferrer"><strong>{content.footer.openSource}</strong><span>{content.footer.license}</span></a>
    <a href={content.hero.primaryCta.href} target="_blank" rel="noreferrer"><strong>{content.hero.platforms}</strong><span>{content.footer.platforms}</span></a>
    <a href={content.footer.documentationHref} target="_blank" rel="noreferrer"><strong>{content.footer.documentation}</strong><span>{content.footer.documentationBody}</span></a>
    <a href={content.footer.communityHref} target="_blank" rel="noreferrer"><strong>{content.footer.community}</strong><span>{content.footer.communityBody}</span></a>
    <p class="copyright">© {content.footer.copyrightYears} {content.footer.copyright}</p>
  </footer>
</div>

<script>
  const gallery = document.querySelector<HTMLElement>("#theme-gallery");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const scrollBehavior = () => reducedMotion.matches ? "auto" : "smooth";
  document.querySelector<HTMLButtonElement>(".gallery-control.previous")?.addEventListener("click", () => {
    gallery?.scrollBy({ left: -(gallery.clientWidth * 0.72), behavior: scrollBehavior() });
  });
  document.querySelector<HTMLButtonElement>(".gallery-control.next")?.addEventListener("click", () => {
    gallery?.scrollBy({ left: gallery.clientWidth * 0.72, behavior: scrollBehavior() });
  });

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
  const selectTab = (nextIndex: number, moveFocus = false) => {
    tabs.forEach((tab, index) => {
      const selected = index === nextIndex;
      tab.setAttribute("aria-selected", String(selected));
      tab.tabIndex = selected ? 0 : -1;
      panels[index].hidden = !selected;
    });
    if (moveFocus) tabs[nextIndex].focus();
    tabs[nextIndex].scrollIntoView({ inline: "nearest", block: "nearest", behavior: scrollBehavior() });
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(index));
    tab.addEventListener("keydown", (event) => {
      let nextIndex = index;
      if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = tabs.length - 1;
      else return;
      event.preventDefault();
      selectTab(nextIndex, true);
    });
  });
</script>

<style>
  .site-shell {
    /* Viewport-relative so section padding and content calcs share one coordinate system. */
    --spine-x: 39vw;
    --spine-clear: 1.35rem;
    --inline-pad: max(5vw, calc((100vw - 90rem) / 2));
    --pattern-size: 30rem;
    --pattern-phase-x: 0rem;
    overflow: clip;
    background: var(--c-accent-2);
  }

  .hero {
    position: relative;
    min-height: min(56.25vw, 54rem);
    color: var(--c-base);
    background: var(--c-accent-2);
    isolation: isolate;
    /* Do not clip spine seams; media is contained by its own absolute inset. */
    overflow: visible;
  }

  .hero-media,
  .deco-atmosphere,
  .pattern-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-media {
    z-index: -2;
    overflow: hidden;
    background: var(--hero-image) center / cover no-repeat;
  }

  .deco-atmosphere {
    z-index: -1;
    background: var(--pattern-deco) center / 46rem repeat;
    opacity: 0.07;
    mask-image: radial-gradient(circle at 12% 44%, var(--c-base), transparent 67%);
  }

  .site-nav {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(92rem, calc(100% - 4rem));
    margin: 0 auto;
    padding: 1.45rem 0;
  }

  .brand,
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .brand-mark {
    display: grid;
    width: 2.35rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--c-brass);
    transform: rotate(45deg);
    color: var(--c-base);
  }

  .brand-mark > span,
  .index > span,
  .step-index > span { transform: rotate(-45deg); }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.2rem);
    font-size: 0.92rem;
  }

  .desktop-nav a,
  .site-footer a { transition: color 180ms ease; }
  .desktop-nav a:hover,
  .desktop-nav a:focus-visible,
  .site-footer a:hover,
  .site-footer a:focus-visible { color: var(--c-primary); }

  .mobile-nav { display: none; }

  .hero-copy {
    position: relative;
    z-index: 3;
    /* Stay fully to the right of the spine corridor. */
    width: min(44rem, calc(100% - var(--spine-x) - var(--spine-clear) - 4rem));
    margin-left: max(49%, calc(var(--spine-x) + var(--spine-clear) + 1rem));
    padding-top: clamp(6rem, 12vw, 11rem);
  }

  h1,
  h2,
  h3,
  p { margin-top: 0; }

  h1,
  h2 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  h1 {
    max-width: 13ch;
    margin-bottom: 1.6rem;
    font-size: clamp(3rem, 5vw, 6.2rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .hero-copy > p:not(.platforms) {
    max-width: 36rem;
    color: color-mix(in srgb, var(--c-base) 75%, transparent);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.65;
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 2rem 0 1.25rem;
  }

  .button {
    display: inline-flex;
    min-height: 3.35rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 1.35rem;
    border: 1px solid var(--c-brass);
    border-radius: 0.55rem;
    font-weight: 700;
    transition: transform 180ms ease, background 180ms ease;
  }

  .button:hover,
  .button:focus-visible { transform: translateY(-2px); }
  .button.primary { border-color: var(--c-primary); background: var(--c-primary); color: var(--c-accent-2); }
  .button.secondary { background: color-mix(in srgb, var(--c-accent-2) 78%, transparent); }
  .button.light { color: var(--c-accent-2); background: var(--c-base); }

  .platforms,
  .cta-actions > p {
    color: color-mix(in srgb, var(--c-base) 65%, transparent);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
  }

  /*
   * Page spine system
   * - One vertical rail at --spine-x in every major section (no stub gaps).
   * - Diamonds live at the TOP of the receiving section (translateY -50%) so the
   *   later sibling paints them on the seam — never buried under the next bg.
   * - Content stacks above the rail; opaque cards let the rail pass behind.
   * - Left-of-spine copy is width-clamped so glyphs never sit on the rail.
   */
  .spine {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: var(--spine-x);
    width: 1px;
    background: color-mix(in srgb, var(--c-brass) 88%, transparent);
    pointer-events: none;
  }

  .hero-spine { top: 8rem; bottom: 0; }

  .spine-node {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 50%;
    width: 2.35rem;
    aspect-ratio: 1;
    border: 1px solid var(--c-brass);
    background: var(--c-accent-2);
    transform: translate(-50%, -50%) rotate(45deg);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c-base) 0%, transparent);
  }

  /* Paper seams: give the diamond a paper halo so it reads on light sections. */
  .paper-section .spine-node {
    box-shadow: 0 0 0 5px var(--c-base);
  }

  .spine-branch {
    position: absolute;
    top: 4.5rem;
    left: 0;
    width: clamp(3.5rem, 10vw, 9rem);
    height: 1px;
    background: color-mix(in srgb, var(--c-brass) 70%, transparent);
  }

  .spine-branch--ticket {
    top: auto;
    bottom: 0;
    width: min(36vw, 34rem);
    background: color-mix(in srgb, var(--c-brass) 78%, transparent);
  }

  .spine-node--end {
    top: auto;
    bottom: 0;
    left: min(36vw, 34rem);
    width: 0.85rem;
    /* Sit on the terminus line (not half-buried under the ticket). */
    transform: translate(-50%, 50%) rotate(45deg);
    background: var(--c-accent-2);
    box-shadow: 0 0 0 3px var(--c-accent-2);
  }

  .paper-section {
    position: relative;
    isolation: isolate;
    color: var(--c-accent-2);
    background: var(--c-base);
  }

  .pattern-layer {
    z-index: -1;
    background-image: var(--pattern-ink);
    background-position: var(--pattern-phase-x) 0;
    background-size: var(--pattern-size);
    opacity: 0.34;
    animation: pattern-drift 80s linear infinite;
    mask-image: linear-gradient(to right, var(--c-base), transparent 48%, var(--c-base));
  }

  @keyframes pattern-drift {
    to { background-position: calc(var(--pattern-phase-x) + var(--pattern-size)) 0; }
  }

  .capabilities {
    display: grid;
    min-height: 47rem;
    /* Left track ends before the spine; right track starts after it. */
    grid-template-columns:
      minmax(14rem, calc(var(--spine-x) - var(--inline-pad) - var(--spine-clear)))
      minmax(22rem, 1fr);
    column-gap: calc(var(--spine-clear) * 2);
    align-items: center;
    padding: 7rem var(--inline-pad);
  }

  .section-intro,
  .workflow-intro,
  .capability-list,
  .workflow-steps {
    position: relative;
    z-index: 2;
  }

  .section-intro {
    max-width: 24rem;
    /* Hard stop so title glyphs never cross the rail. */
    width: min(24rem, calc(var(--spine-x) - var(--inline-pad) - var(--spine-clear)));
  }

  .section-intro h2,
  .workflow-intro h2,
  .gallery-head h2,
  .ticket h2 {
    margin-bottom: 1.25rem;
    font-size: clamp(2.8rem, 5vw, 5.8rem);
    line-height: 0.95;
  }

  .section-intro p,
  .workflow-intro p { font-size: 1.1rem; line-height: 1.7; }

  .capability-list,
  .workflow-steps { margin: 0; padding: 0; list-style: none; }
  .capability-list { display: grid; gap: 1rem; }
  .capability-list li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    min-height: 7rem;
    padding: 1.35rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--c-brass) 55%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--c-base) 88%, var(--c-accent-1));
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--c-accent-2) 8%, transparent);
  }
  .capability-list li:nth-child(even) { background: color-mix(in srgb, var(--c-base) 78%, var(--c-accent-1)); }
  .capability-list h3 { margin-bottom: 0.4rem; font-size: 1.15rem; }
  .capability-list p { margin-bottom: 0; color: color-mix(in srgb, var(--c-accent-2) 72%, transparent); line-height: 1.55; }
  .index {
    display: grid;
    width: 3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--c-brass);
    transform: rotate(45deg);
    font-family: var(--font-display);
  }
  .row-arrow { color: var(--c-accent-1); font-size: 2rem; }

  .workflow {
    position: relative;
    min-height: 46rem;
    padding: 6rem var(--inline-pad) 7rem;
  }

  .workflow-spine {
    top: 0;
    bottom: 0;
    z-index: 1;
  }

  .workflow-intro {
    position: relative;
    z-index: 2;
    max-width: min(32rem, calc(var(--spine-x) - var(--inline-pad) - var(--spine-clear)));
    margin-bottom: 4rem;
  }

  .workflow-steps {
    /*
     * Column 1 ends just before the page spine so left-aligned node 02 is
     * centered on --spine-x. Nodes 01/03 stay left-aligned in their tracks.
     * --s is spine x inside the padded content box.
     */
    --step-gap: clamp(1.25rem, 4vw, 4rem);
    --step-node: 2.8rem;
    --step-node-r: calc(var(--step-node) / 2);
    --s: calc(var(--spine-x) - var(--inline-pad));
    --col1: calc(var(--s) - var(--step-gap) - var(--step-node-r));
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns:
      minmax(0, var(--col1))
      minmax(0, 1fr)
      minmax(0, 1fr);
    gap: var(--step-gap);
    margin-bottom: 2.5rem;
  }

  /*
   * Horizontal rail: center of node 01 → center of node 03.
   * Vertical page spine runs full section height and crosses node 02.
   */
  .workflow-steps::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: var(--step-node-r);
    left: var(--step-node-r);
    /* right inset = last-col width - node radius; last two cols share remaining space equally. */
    right: calc((100% - var(--col1) - 2 * var(--step-gap)) / 2 - var(--step-node-r));
    height: 1px;
    background: color-mix(in srgb, var(--c-brass) 88%, transparent);
  }

  .workflow-steps li { position: relative; }

  .step-index {
    position: relative;
    z-index: 1;
    display: grid;
    width: var(--step-node);
    aspect-ratio: 1;
    place-items: center;
    margin: 0 0 1.25rem;
    border: 1px solid var(--c-brass);
    background: var(--c-accent-2);
    color: var(--c-base);
    transform: rotate(45deg);
    /* Halo so the horizontal rail is interrupted cleanly by the diamond. */
    box-shadow: 0 0 0 5px var(--c-base);
  }

  /*
   * Keep diamonds on the timeline/spine, but nudge title + body + card right
   * so the vertical rail clears step-02 copy and card chrome.
   */
  .workflow-steps h3,
  .workflow-steps li > p,
