---
type Step = { name: string; artifact: string; body: string };
type Props = {
  content: {
    eyebrow: string;
    heading: string;
    body: string;
    steps: Step[];
  };
};

const { content } = Astro.props;
const accentColors = ["var(--c-primary)", "var(--c-accent-1)", "var(--c-accent-2)", "var(--c-primary)", "var(--c-accent-1)"];
---

<section id="pipeline" class="bg-[var(--c-base)] py-24">
  <div class="content-wrap">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="construct-diamond" style="background: var(--c-accent-1);"></span>
        <p class="text-sm font-bold uppercase tracking-[0.28em] text-[var(--c-primary)]">{content.eyebrow}</p>
      </div>
      <h2 class="mt-5 text-4xl font-black leading-tight text-white md:text-5xl">{content.heading}</h2>
      <p class="mt-6 text-lg leading-relaxed text-white/50">{content.body}</p>
    </div>

    <!-- Constructivist pipeline: 5 steps with diamond numbers + connecting lines -->
    <div class="mt-14 grid gap-[var(--construct-gap)] md:grid-cols-5">
      {content.steps.map((step, index) => (
        <article class="construct-block relative bg-[rgb(var(--c-base-rgb)_/_0.6)] p-6">
          <div class="mb-6 flex items-center gap-3">
            <span
              class="construct-diamond"
              style={`width: 1.5rem; height: 1.5rem; background: ${accentColors[index]};`}
            ></span>
            <span class="font-mono text-xs text-white/40">0{index + 1}</span>
          </div>
          <h3 class="text-lg font-bold text-white">{step.name}</h3>
          <p class="mt-2 border-l-[2px] border-[var(--c-primary)] bg-[rgb(var(--c-primary-rgb)_/_0.08)] px-3 py-1 font-mono text-xs text-[var(--c-primary)]">
            {step.artifact}
          </p>
          <p class="mt-4 text-sm leading-relaxed text-white/50">{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
