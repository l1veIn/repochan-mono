---
type Item = { path: string; label: string };
type Props = {
  content: {
    eyebrow: string;
    heading: string;
    body: string;
    items: Item[];
  };
};

const { content } = Astro.props;
---

<section id="protocol" class="relative overflow-hidden bg-white py-24">
  <!-- DAG grid texture overlay (tile-1) -->
  <div class="texture-divider absolute inset-0"></div>

  <div class="content-wrap relative grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <div class="flex items-center gap-3">
        <span class="construct-diamond" style="background: var(--c-accent-2);"></span>
        <p class="text-sm font-bold uppercase tracking-[0.28em] text-[var(--c-base)]">{content.eyebrow}</p>
      </div>
      <h2 class="mt-5 text-4xl font-black leading-tight text-[var(--c-base)] md:text-5xl">{content.heading}</h2>
      <p class="mt-6 text-lg leading-relaxed text-black/50">{content.body}</p>
    </div>

    <!-- Terminal panel: hard edges, constructivist window chrome -->
    <div class="construct-block bg-[var(--c-base)] p-6">
      <!-- Window dots as constructivist color squares (not circles) -->
      <div class="mb-5 flex gap-[3px]">
        <span class="h-4 w-4" style="background: var(--c-accent-2);"></span>
        <span class="h-4 w-4" style="background: var(--c-primary);"></span>
        <span class="h-4 w-4" style="background: var(--c-accent-1);"></span>
      </div>
      <div class="space-y-[3px] font-mono text-sm">
        {content.items.map((item) => (
          <div class="grid gap-2 border-[2px] border-white/10 p-4 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)]">
            <span class="break-all text-[var(--c-primary)]">{item.path}</span>
            <span class="text-white/40">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
