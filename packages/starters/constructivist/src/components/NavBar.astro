---
type Link = { label: string; href: string };
type Props = {
  brand: string;
  links: Link[];
  cta: string;
  lang: "en" | "zh";
};

const { brand, links, cta, lang } = Astro.props;
const switchHref = lang === "en" ? "/zh/" : "/";
const switchLabel = lang === "en" ? "中文" : "EN";
---

<header class="sticky top-0 z-50 border-b-[3px] border-[var(--construct-line-color)] bg-[var(--c-base)] max-w-[1280px] mx-auto w-full border-x-[3px]">
  <nav class="grid grid-cols-1 lg:grid-cols-[1fr_340px] items-center h-16 w-full">
    <!-- Left: Logo & Menu links -->
    <div class="flex items-center justify-between px-6 lg:px-12 h-full border-r-0 lg:border-r-[3px] border-[var(--construct-line-color)] bg-[var(--c-base)]">
      <a href={lang === "en" ? "/" : "/zh/"} class="flex items-center gap-2">
        <span class="text-2xl font-black tracking-tight text-white select-none">
          Repo<span class="text-[var(--c-primary)]">Chan</span>
        </span>
      </a>

      <!-- Desktop Links -->
      <div class="hidden md:flex items-center gap-8 text-sm font-bold uppercase tracking-wider">
        {links.map((link) => (
          <a class="text-white hover:text-[var(--c-primary)] transition-colors" href={link.href}>
            {link.label}
          </a>
        ))}
      </div>

      <!-- Language & Mobile CTA -->
      <div class="flex items-center gap-4">
        <a class="text-sm font-bold text-white/60 hover:text-[var(--c-primary)] transition-colors" href={switchHref}>
          {switchLabel}
        </a>
        <!-- Mobile-only GitHub icon button -->
        <a
          class="lg:hidden flex items-center justify-center p-2 border-2 border-[var(--c-primary)] text-[var(--c-primary)] hover:bg-[var(--c-primary)] hover:text-black transition-colors"
          style="border-radius: var(--construct-radius);"
          href="https://github.com/l1veIn/repochan-mono"
          target="_blank"
          rel="noopener noreferrer"
          title="Star on GitHub"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right: Desktop Star on GitHub -->
    <div class="hidden lg:flex items-center justify-center h-full bg-[var(--c-primary)]">
      <a
        class="flex items-center justify-center gap-3 w-full h-full text-base font-black uppercase text-black hover:bg-white transition-colors"
        href="https://github.com/l1veIn/repochan-mono"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        <span>{cta}</span>
      </a>
    </div>
  </nav>
</header>
