{
  "id": "constructivist",
  "name": "Constructivist Landing",
  "description": "构成主义风格:硬边色块、菱形 motif、角色-留白合成 hero。角色在右侧,抬腿伸手的动态姿态巧妙地在手下方留出 CTA 按钮位置;左侧暗区留给 HTML 文字层。",
  "style": "constructivist",
  "tags": ["landing", "constructivist", "hero", "cel-shaded"],
  "default": true,
  "assets": [
    {
      "slot": "hero-composite",
      "reference": "public/assets/hero-composite.webp",
      "description": "4K L1L2 合成背景图(角色+背景已融合),角色在右侧抬腿伸手,左侧暗区留白给文字层。抬手下方自然形成的负空间用于 CTA 按钮。",
      "order": {
        "assetType": "hero_composite",
        "templateId": "official/hero-character-migrate",
        "brief": {
          "mustInclude": [
            "left 55% of the frame must remain empty (dark, atmospheric) for HTML text overlay",
            "the negative space below the character's raised arm is reserved for CTA button placement"
          ],
          "avoid": ["any text or UI elements", "deviating from foundation character identity"],
          "creativeFreedom": ["low"]
        },
        "deliverables": [{"name": "hero-composite", "format": "png", "width": 2560, "height": 1440, "aspectRatio": "16:9"}],
        "references": [
          {"type": "file", "path": "public/assets/hero-pose-lineart.png", "role": "composition"}
        ]
      },
      "postprocess": [
        {"op": "compress", "args": {"format": "webp", "quality": 82, "maxWidth": 2560}, "out": "public/assets/hero-composite.webp"}
      ]
    },
    {
      "slot": "character-cutout",
      "reference": "public/assets/character/hero-character.png",
      "description": "matte 底角色独立图,chroma-key 抠透明后可独立运动(策略 D 备选)",
      "postprocess": [
        {"op": "chroma-key", "args": {"matte": "auto"}, "out": "public/assets/character/hero-character.png"}
      ]
    },
    {
      "slot": "chibi-grid",
      "reference": "public/assets/chibi",
      "description": "chibi 3×3 表情网格,切片后用于 features/gallery 装饰",
      "postprocess": [
        {"op": "slice", "args": {"rows": 3, "cols": 3}, "out": "public/assets/chibi/"}
      ]
    },
    {
      "slot": "texture-hero-bg",
      "reference": "public/textures/hero-bg.png",
      "description": "hero section 四方连续背景纹理"
    },
    {
      "slot": "texture-divider",
      "reference": "public/textures/divider.png",
      "description": "边框/分割线四方连续纹理"
    },
    {
      "slot": "texture-sideband",
      "reference": "public/textures/sideband.png",
      "description": "侧边装饰四方连续纹理"
    },
    {
      "slot": "texture-cta",
      "reference": "public/textures/cta-bg.png",
      "description": "CTA 底纹四方连续纹理"
    },
    {
      "slot": "favicon",
      "reference": "public/favicon.ico",
      "description": "多分辨率 favicon.ico(由 icon-single resize+favicon 生成)",
      "postprocess": [
        {"op": "resize", "args": {"sizes": [16, 32, 48, 180, 192, 512]}, "out": "public/assets/favicon/"},
        {"op": "favicon", "args": {"sizes": [16, 32, 48, 180, 256]}, "out": "public/favicon.ico"}
      ]
    }
  ]
}
