---
import SiteLayout from "../layouts/SiteLayout.astro";
import Nav from "../components/Nav.astro";
import CityExplorer from "../components/CityExplorer.astro";
import SouvenirStrip from "../components/SouvenirStrip.astro";
import Footer from "../components/Footer.astro";
import { getContent } from "../lib/site";

const t = getContent("zh");
---

<SiteLayout title={t.meta.title} description={t.meta.description} locale="zh">
  <Nav content={t.nav} locale="zh" />
  <main>
    <CityExplorer content={t} />
    <SouvenirStrip content={t.souvenir} />
  </main>
  <Footer content={t.footer} />
</SiteLayout>
