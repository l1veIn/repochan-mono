---
import "../styles/global.css";
import { site, assets, alternatePath, buildCssVars, type Locale } from "../lib/site";

type Props = {
  title: string;
  description: string;
  locale: Locale;
};

const { title, description, locale } = Astro.props;
const htmlLang = locale === "zh" ? "zh-CN" : "en";
const cssVars = buildCssVars();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.theme.primary} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={assets.og.src} />
    <meta property="og:image:width" content={String(assets.og.width)} />
    <meta property="og:image:height" content={String(assets.og.height)} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang={htmlLang} href={locale === "zh" ? "/" : "/en/"} />
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={alternatePath(locale)} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat:wght@600;700&family=Zhi+Mang+Xing&family=Noto+Sans+SC:wght@400;500;700;900&family=Noto+Serif+SC:wght@700;900&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={cssVars} />
  </head>
  <body>
    <!-- 纸纹颗粒 -->
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <script>
      import "../lib/zine";
    </script>
  </body>
</html>
