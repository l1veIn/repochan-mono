        "empty": {
          "src": "/assets/sticker-3.webp",
          "status": "source"
        },
        "error": {
          "src": "/assets/sticker-4.webp",
          "status": "source"
        },
        "success": {
          "src": "/assets/sticker-5.webp",
          "status": "source"
        },
        "not-found": {
          "src": "/assets/sticker-6.webp",
          "status": "source"
        },
        "cta": {
          "src": "/assets/sticker-7.webp",
          "status": "source"
        },
        "cozy": {
          "src": "/assets/sticker-8.webp",
          "status": "source"
        }
