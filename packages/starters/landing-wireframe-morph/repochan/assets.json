{
  "schemaVersion": "repochan.starter-assets.v1",
  "assets": {
    "cutout-a": {
      "kind": "scalar",
      "src": "/assets/cutout-a.webp",
      "status": "source",
      "orderId": "ord-cutout-001"
    },
    "lineart-full": {
      "kind": "scalar",
      "src": "/assets/lineart-full.webp",
      "status": "source",
      "orderId": "ord-lineart-001"
    },
    "foundation": {
      "kind": "scalar",
      "src": "/assets/foundation.webp",
      "status": "source",
      "orderId": "ord-foundation-001"
    },
    "pattern": {
      "kind": "scalar",
      "src": "/assets/pattern.webp",
      "status": "source",
      "orderId": "ord-pattern-001"
    },
    "studio-wide": {
      "kind": "scalar",
      "src": "/assets/studio-wide.webp",
      "status": "source"
    },
    "icon": {
      "kind": "scalar",
      "src": "/assets/icon.webp",
      "status": "source",
      "orderId": "ord-icon-001"
    },
    "stickers": {
      "kind": "bundle",
      "status": "source",
      "items": {
        "welcome": {
          "src": "/assets/sticker-0.webp",
          "status": "source"
