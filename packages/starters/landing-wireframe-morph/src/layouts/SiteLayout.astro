---
import "../styles/global.css";
import { site, assets, alternatePath, buildCssVars, type Locale } from "../lib/site";
import type { SiteContent } from "../lib/i18n/types";

type Props = {
  title: string;
  description: string;
  locale: Locale;
  content: SiteContent;
};

const { title, description, locale, content } = Astro.props;
const htmlLang = locale === "zh" ? "zh-CN" : "en";
const cssVars = buildCssVars();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.theme.base} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={assets.og.src} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <link rel="alternate" hreflang={htmlLang} href={locale === "zh" ? "/" : "/en/"} />
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={alternatePath(locale)} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+SC:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={cssVars} />
  </head>
  <body>
    <header class="rail" aria-label={content.rail.renderLabel}>
      <a class="rail-brand" href="#stage-0">
        <span class="rail-icon" aria-hidden="true">
          <svg class="rail-icon-wire" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="12" cy="12" r="5" />
            <path d="M12 3v4M12 17v4M3 12h4M17 12h4" />
          </svg>
          <img class="rail-icon-color" src={assets.icon.src} width="24" height="24" alt="" />
        </span>
        <span class="rail-word">REPOCHAN</span>
      </a>
      <nav class="rail-stages" aria-label={content.rail.renderLabel}>
        {content.rail.stages.map((label, i) => (
          <a href={`#stage-${i}`} data-rail-dot class="rail-dot">
            <span class="rail-dot-tick" aria-hidden="true" />
            <span class="rail-dot-label">{label}</span>
          </a>
        ))}
      </nav>
      <div class="rail-status">
        <span class="rail-render">{content.rail.renderLabel}</span>
        <span class="rail-pct" data-rail-pct>0%</span>
        <a class="rail-locale" href={alternatePath(locale)}>{content.rail.localeSwitch}</a>
      </div>
      <span class="rail-bar" aria-hidden="true"><span class="rail-bar-fill" data-rail-fill /></span>
    </header>

    <aside class="toggles" aria-label={content.toggles.title}>
      <span class="toggles-title">{content.toggles.title}</span>
      {content.toggles.items.map((item) => (
        <button type="button" class="toggle" data-layer={item.key} aria-pressed="true">
          <span class="toggle-led" aria-hidden="true" />
          {item.label}
        </button>
      ))}
    </aside>

    <nav class="snapshots" aria-label={content.snapshots.title}>
      <span class="snapshots-title">{content.snapshots.title}</span>
      {content.snapshots.items.map((item) => (
        <a href={`#${item.target}`} class="snapshot-link">{item.label}</a>
      ))}
    </nav>

    <slot />

    <script>
      import "../lib/motion";
    </script>
  </body>
</html>
