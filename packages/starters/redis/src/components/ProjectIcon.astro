---
type Props = { kind: string; size?: number };
const { kind, size = 30 } = Astro.props;
---

<svg class="project-icon" width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  {kind === "cache" && <><path d="m5 9 11-5 11 5-11 5L5 9Z"/><path d="m5 15 11 5 11-5M5 21l11 6 11-6"/></>}
  {kind === "search" && <><circle cx="14" cy="14" r="8"/><path d="m20 20 7 7"/></>}
  {kind === "streams" && <><path d="M4 12c4-5 8-5 12 0s8 5 12 0M4 20c4-5 8-5 12 0s8 5 12 0"/><circle cx="4" cy="12" r="1.5"/><circle cx="28" cy="20" r="1.5"/></>}
  {kind === "vector" && <><circle cx="7" cy="8" r="2"/><circle cx="24" cy="6" r="2"/><circle cx="25" cy="24" r="2"/><circle cx="8" cy="25" r="2"/><path d="m9 8 13-2M24 8l1 14M23 24l-13 1M8 23 7 10M9 9l14 14"/></>}
  {kind === "client" && <><rect x="5" y="6" width="22" height="15" rx="2"/><path d="M11 27h10M16 21v6"/></>}
  {kind === "resp" && <><path d="m12 8-7 8 7 8M20 8l7 8-7 8M18 5l-4 22"/></>}
  {kind === "core" && <><path d="m5 10 11-5 11 5-11 5L5 10Z"/><path d="m5 16 11 5 11-5M5 22l11 5 11-5"/></>}
  {kind === "modules" && <><rect x="5" y="5" width="9" height="9" rx="1"/><rect x="18" y="5" width="9" height="9" rx="1"/><rect x="5" y="18" width="9" height="9" rx="1"/><rect x="18" y="18" width="9" height="9" rx="1"/></>}
  {kind === "response" && <path d="m19 3-10 15h7l-3 11 10-16h-7l3-10Z"/>}
</svg>

<style>
  .project-icon { stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
</style>
