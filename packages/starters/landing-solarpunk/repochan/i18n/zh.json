    "soil": {
      "stage": "STAGE 01 · 验土",
      "title": "先看看这块地",
      "note": "repochan analysis 先做确定性扫描，再叠加 LLM 预分析——像播种前的土壤检测：成分、墒情、围栏，一份报告写进 .repochan/analysis/。",
      "cards": [
        {
          "term": "语言构成",
          "value": "TypeScript 主壤",
          "desc": "语言与文件分布决定这块地适合种什么。"
        },
        {
          "term": "依赖生态",
          "value": "pnpm monorepo",
          "desc": "包、框架与工具链自动归类，共生关系一目了然。"
        },
        {
          "term": "提交节律",
          "value": "持续生长",
          "desc": "提交频率与活跃周期，是仓库的墒情。"
        },
        {
          "term": "社区围栏",
          "value": "双语 README",
          "desc": "文档、协议与行为准则，决定果园对外开放的方式。"
