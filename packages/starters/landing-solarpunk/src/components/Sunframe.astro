---
import { assets } from "../lib/site";
import type { SunframeContent } from "../lib/i18n/types";

type Props = { content: SunframeContent };
const { content } = Astro.props;
---

<section class="section sunframe" id="sunframe">
  <div class="shell sunframe-grid">
    <figure class="plaque" data-grow>
      <div class="frame">
        <span class="nail tl" aria-hidden="true"></span>
        <span class="nail tr" aria-hidden="true"></span>
        <img src={assets.foundationPlaque.src} alt={content.plaqueAlt} width={assets.foundationPlaque.width} height={assets.foundationPlaque.height} loading="lazy" />
      </div>
      <figcaption class="mono">{content.plaqueCaption}</figcaption>
    </figure>

    <div class="points">
      <p class="stage-label" data-grow>{content.stage}</p>
      <h2 class="section-title display" data-grow data-grow-delay="1">{content.title}</h2>
      <p class="section-note" data-grow data-grow-delay="2">{content.note}</p>
      <ul>
        {content.points.map((p, i) => (
          <li data-grow data-grow-delay={String(i + 1)}>
            <span class="sun-dot" aria-hidden="true"></span>
            <div>
              <strong>{p.term}</strong>
              <p>{p.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .sunframe { background: var(--paper); }
  .sunframe-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .plaque { margin: 0; text-align: center; }
  .frame {
    position: relative;
    background: var(--clay);
    border-radius: 18px;
    padding: 14px;
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, var(--ink) 12%, transparent),
      0 10px 24px color-mix(in srgb, var(--clay) 45%, transparent);
  }
  .frame img {
    border-radius: 8px;
    width: 100%;
  }
  .nail {
    position: absolute;
    top: 8px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink-soft);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--ink) 40%, transparent);
  }
  .nail.tl { left: 8px; }
  .nail.tr { right: 8px; }
  .plaque figcaption {
    margin-top: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .points ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
  }
  .points li {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
  }
  .sun-dot {
    flex: none;
    width: 0.85em;
    height: 0.85em;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sun) 28%, transparent);
    transform: translateY(0.08em);
  }
  .points strong {
    font-size: 1.02rem;
    color: var(--ink);
  }
  .points p {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .sunframe-grid { grid-template-columns: 1fr; }
    .plaque { max-width: 420px; margin-inline: auto; }
  }
</style>
