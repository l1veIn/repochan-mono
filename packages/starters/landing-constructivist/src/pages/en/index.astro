---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Masthead from "../../components/Masthead.astro";
import PosterCall from "../../components/PosterCall.astro";
import PosterAnalysis from "../../components/PosterAnalysis.astro";
import PosterPersona from "../../components/PosterPersona.astro";
import PosterFoundation from "../../components/PosterFoundation.astro";
import PosterPainter from "../../components/PosterPainter.astro";
import PosterProduct from "../../components/PosterProduct.astro";
import PosterCta from "../../components/PosterCta.astro";
import Progress from "../../components/Progress.astro";
import Colophon from "../../components/Colophon.astro";
import { getContent } from "../../lib/site";

const t = getContent("en");
---

<SiteLayout title={t.meta.title} description={t.meta.description} locale="en">
  <Masthead content={t.masthead} locale="en" />
  <main>
    <PosterCall content={t.posters.call} />
    <PosterAnalysis content={t.posters.analysis} />
    <PosterPersona content={t.posters.persona} />
    <PosterFoundation content={t.posters.foundation} />
    <PosterPainter content={t.posters.painter} />
    <PosterProduct content={t.posters.product} />
    <PosterCta content={t.posters.cta} />
  </main>
  <Colophon content={t.colophon} />
  <Progress count={7} label={t.progress.label} />
</SiteLayout>
