---
import Poster from "./Poster.astro";
import { assets } from "../lib/site";
import type { ProductPosterContent } from "../lib/i18n/types";

type Props = { content: ProductPosterContent };
const { content } = Astro.props;

const figureSrcs = [assets.evidenceFoundation, assets.evidencePoster];
---

<Poster id="p-06" theme="cream" variant="product" content={content}>
  <div class="geo geo-bar geo-bar--thin geo-bar--blue" slot="geo" aria-hidden="true"></div>
  <div class="p-figures">
    {content.figures.map((fig, i) => (
      <figure class="p-figure">
        <img src={figureSrcs[i].src} alt={fig.alt} width={figureSrcs[i].width} height={figureSrcs[i].height} loading="lazy" />
        <figcaption>{fig.caption}</figcaption>
      </figure>
    ))}
  </div>
</Poster>
