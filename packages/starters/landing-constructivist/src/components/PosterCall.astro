---
import Poster from "./Poster.astro";
import { assets } from "../lib/site";
import type { PosterContent } from "../lib/i18n/types";

type Props = { content: PosterContent };
const { content } = Astro.props;
---

<Poster id="p-01" theme="cream" variant="call" content={content} halftone="normal">
  <div class="geo geo-bar" slot="geo" aria-hidden="true"></div>
  <div
    class="symbol"
    slot="geo"
    aria-hidden="true"
    style={`-webkit-mask-image:url(${assets.symbolA.src});mask-image:url(${assets.symbolA.src})`}
  ></div>
</Poster>
