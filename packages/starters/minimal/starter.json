{
  "id": "minimal",
  "name": "Minimal Hero",
  "description": "简化测试用 starter:只含 Hero section,用于迁移管道测试。构造同 constructivist 但剥离了 features/gallery/pipeline/protocol/workflow/cta 等非必要 section。",
  "style": "constructivist",
  "tags": ["landing", "hero", "test", "minimal"],
  "default": false,
  "assets": [
    {
      "slot": "hero-composite",
      "reference": "public/assets/hero-pose-lineart.webp",
      "description": "4K L1L2 合成背景图(角色+背景已融合),角色在右侧抬腿伸手,左侧暗区留白给文字层。抬手下方自然形成的负空间用于 CTA 按钮。",
      "order": {
        "assetType": "hero_composite",
        "templateId": "official/hero-character-migrate",
        "brief": {
          "mustInclude": [
            "left 55% of the frame must remain empty (dark, atmospheric) for HTML text overlay",
            "the negative space below the character's raised arm is reserved for CTA button placement"
          ],
          "avoid": ["any text or UI elements", "deviating from foundation character identity"],
          "creativeFreedom": ["low"]
        },
        "deliverables": [{"name": "hero-composite", "format": "png", "width": 2560, "height": 1440, "aspectRatio": "16:9"}],
        "references": [
          {"type": "file", "path": "public/assets/hero-pose-lineart.webp", "role": "composition"}
        ]
      },
      "postprocess": [
        {"op": "compress", "args": {"format": "webp", "quality": 82, "maxWidth": 2560}, "out": "public/assets/hero-composite.webp"}
      ]
    },
    {
      "slot": "texture-hero-bg",
      "reference": "public/textures/texture1.webp",
      "description": "hero section 四方连续背景纹理",
      "order":{
        "templateId": "official/pattern-tile"
      },
      "postprocess": [
        {"op": "compress", "args": {"format": "webp", "quality": 82, "maxWidth": 2560}, "out": "public/assets/texture1.webp"}
      ]
    },
    {
      "slot": "favicon",
      "reference": "public/favicon.ico",
      "description": "favicon.ico",
      "order":{
        "templateId": "official/icon-single"
      },
      "postprocess": [
        {"op": "resize", "args": {"sizes": [16, 32, 48, 180, 192, 512]}, "out": "public/assets/favicon/"},
        {"op": "favicon", "args": {"sizes": [16, 32, 48, 180, 256]}, "out": "public/favicon.ico"}
      ]
    }
  ]
}
