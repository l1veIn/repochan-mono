{
  "schemaVersion": "repochan.starter.v1",
  "id": "minimal",
  "name": "Minimal Hero",
  "description": "A single-screen Astro landing page with one project-focused hero.",
  "style": "editorial-tech",
  "tags": ["landing", "hero", "minimal"],
  "default": true,
  "config": {
    "site": "repochan/site.json",
    "assets": "repochan/assets.json",
    "i18nDir": "repochan/i18n"
  },
  "content": {
    "defaultLocale": "en",
    "supportedLocales": ["en", "zh"],
    "requiredPaths": [
      "meta.title",
      "meta.description",
      "content.hero.headline",
      "content.hero.body",
      "content.hero.primaryCta.label",
      "content.hero.primaryCta.href"
    ]
  },
  "capabilities": {
    "sections": [
      {
        "id": "hero",
        "required": true,
        "recipe": "hero-composite-live-copy",
        "provenance": {
          "type": "design-reference",
          "reference": "public/assets/hero-pose-lineart.webp"
        },
        "bakedLayers": ["L1", "L2"],
        "liveLayers": ["L3", "L4"],
        "canonicalViewport": { "width": 2560, "height": 1440 },
        "safeZones": [
          { "id": "live-copy", "x": 0.06, "y": 0.18, "width": 0.44, "height": 0.64 }
        ],
        "responsive": {
          "mode": "recompose",
          "notes": "Keep live copy before the artwork in reading order and preserve the character face and primary CTA at narrow widths."
        },
        "assetSlots": ["hero-composite"],
        "motion": []
      }
    ],
    "transitions": []
  },
  "assets": [
    {
      "slot": "hero-composite",
      "required": true,
      "reference": "public/assets/hero-pose-lineart.webp",
      "output": "public/assets/hero-composite.webp",
      "description": "A 16:9 character composition with the character on the right and quiet negative space on the left for live HTML copy.",
      "order": {
        "assetType": "hero_composite",
        "templateId": "official/hero-character-migrate",
        "brief": {
          "mustInclude": [
            "keep the left half quiet enough for live HTML typography",
            "preserve the reference composition while using the project's foundation character"
          ],
          "avoid": ["rendered text", "logos", "UI baked into the image"],
          "creativeFreedom": ["lighting", "background details that support the project identity"]
        },
        "deliverables": [
          {
            "name": "hero-composite",
            "format": "png",
            "width": 2560,
            "height": 1440,
            "aspectRatio": "16:9"
          }
        ]
      },
      "postprocess": [
        {
          "op": "compress",
          "args": { "format": "webp", "quality": 82, "maxWidth": 2560 },
          "out": "public/assets/hero-composite.webp"
        }
      ]
    }
  ]
}
