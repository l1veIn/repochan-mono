---
import VisualFrame from "./VisualFrame.astro";
import { assets } from "../config/assets";

type Props = {
  content: {
    eyebrow: string;
    heading: string;
    body: string;
    pending: string;
  };
};

const { content } = Astro.props;
const galleryAssets = assets.filter((a) => ["gallery", "hero", "chibi", "poster", "icon"].includes(a.usage));
---

<section id="gallery" class="relative overflow-hidden bg-[rgb(var(--c-accent-2-rgb)_/_0.08)] py-24">
  <!-- Sideband texture overlay (tile-2) -->
  <div class="texture-sideband absolute inset-0"></div>

  <div class="content-wrap relative">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="construct-diamond"></span>
        <p class="text-sm font-bold uppercase tracking-[0.28em] text-[var(--c-base)]">{content.eyebrow}</p>
      </div>
      <h2 class="mt-5 text-4xl font-black leading-tight text-[var(--c-base)] md:text-5xl">{content.heading}</h2>
      <p class="mt-6 text-lg leading-relaxed text-black/60">{content.body}</p>
    </div>

    <!-- Gallery grid: tight constructivist gap, hard frames -->
    <div class="mt-14 grid gap-[var(--construct-gap)] md:grid-cols-2 lg:grid-cols-3">
      {galleryAssets.map((asset) => (
        <VisualFrame
          compact
          asset={asset}
          title={asset.label}
          caption={asset.status === "pending" ? content.pending : asset.key}
        />
      ))}
    </div>
  </div>
</section>
