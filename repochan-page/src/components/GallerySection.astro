---
import VisualFrame from "./VisualFrame.astro";
import { assets } from "../config/assets";

type Props = {
  content: {
    eyebrow: string;
    heading: string;
    body: string;
    pending: string;
  };
};

const { content } = Astro.props;
const galleryAssets = assets.filter((asset) => ["gallery", "hero", "chibi", "pattern", "poster", "icon"].includes(asset.usage));
---

<section id="gallery" class="bg-mint/45 py-24">
  <div class="content-wrap">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blueprint">{content.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-semibold text-ink md:text-5xl">{content.heading}</h2>
      <p class="mt-5 text-lg leading-8 text-slate-700">{content.body}</p>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {galleryAssets.map((asset) => (
        <VisualFrame compact asset={asset} title={asset.label} caption={`${asset.orderId} · ${asset.status === "pending" ? content.pending : "Ready"}`} />
      ))}
    </div>
  </div>
</section>
