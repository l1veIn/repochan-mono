---
import { getAsset } from "../config/assets";

type Props = {
  cta: {
    heading: string;
    body: string;
    primary: string;
    secondary: string;
  };
  footer: {
    tagline: string;
  };
};

const { cta, footer } = Astro.props;
const chibi = getAsset("chibi");
---

<section class="bg-ink text-white">
  <div class="content-wrap py-20">
    <div class="luma-pattern grid gap-8 rounded-lg border border-white/10 bg-white/[0.03] p-8 md:p-12 lg:grid-cols-[1fr_260px] lg:items-center">
      <div>
        <h2 class="max-w-3xl text-3xl font-semibold md:text-5xl">{cta.heading}</h2>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">{cta.body}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-md bg-blueprint px-5 py-3 font-semibold text-white hover:bg-blue-600" href="https://github.com/l1veIn/repochan-mono">{cta.primary}</a>
          <a class="rounded-md border border-cyanline/40 px-5 py-3 font-semibold text-cyanline hover:bg-white/5" href="https://github.com/l1veIn/repochan-mono#readme">{cta.secondary}</a>
        </div>
      </div>
      {chibi?.src && <img class="hidden w-full rounded-md border border-white/10 bg-white object-contain p-2 lg:block" src={chibi.src} alt="" loading="lazy" />}
    </div>
    <footer class="flex flex-col justify-between gap-4 border-t border-white/10 py-8 text-sm text-slate-400 md:flex-row">
      <span>RepoChan</span>
      <span>{footer.tagline}</span>
    </footer>
  </div>
</section>
