---
import { getAsset } from "../config/assets";

type Link = { label: string; href: string };
type Props = {
  brand: string;
  links: Link[];
  cta: string;
  lang: "en" | "zh";
};

const { brand, links, cta, lang } = Astro.props;
const switchHref = lang === "en" ? "/zh/" : "/";
const switchLabel = lang === "en" ? "中文" : "EN";
const icon = getAsset("icon");
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur">
  <nav class="content-wrap flex h-16 items-center justify-between gap-6">
    <a href={lang === "en" ? "/" : "/zh/"} class="flex items-center gap-3 font-semibold tracking-wide text-ink">
      {icon?.src ? (
        <img class="h-9 w-9 rounded-md border border-slate-200 object-cover" src={icon.src} alt="" />
      ) : (
        <span class="grid h-9 w-9 place-items-center rounded-md bg-ink text-sm text-cyanline">RC</span>
      )}
      <span>{brand}</span>
    </a>
    <div class="hidden items-center gap-6 text-sm text-slate-600 md:flex">
      {links.map((link) => <a class="hover:text-ink" href={link.href}>{link.label}</a>)}
    </div>
    <div class="flex items-center gap-3">
      <a class="text-sm font-medium text-slate-600 hover:text-ink" href={switchHref}>{switchLabel}</a>
      <a class="rounded-md bg-blueprint px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-600" href="https://github.com/l1veIn/repochan-mono">
        {cta}
      </a>
    </div>
  </nav>
</header>
