---
type Props = {
  content: {
    eyebrow: string;
    heading: string;
    steps: string[];
  };
};

const { content } = Astro.props;
---

<section id="workflow" class="bg-white py-24">
  <div class="content-wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blueprint">{content.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-semibold text-ink md:text-5xl">{content.heading}</h2>
    </div>
    <ol class="space-y-4">
      {content.steps.map((step, index) => (
        <li class="flex gap-4 rounded-md border border-slate-200 bg-paper p-5">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-md bg-blueprint text-sm font-semibold text-white">{index + 1}</span>
          <span class="leading-7 text-slate-700">{step}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
