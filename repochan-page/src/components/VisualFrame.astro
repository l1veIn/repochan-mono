---
import type { RepoChanAsset } from "../config/assets";

type Props = {
  asset?: RepoChanAsset;
  title: string;
  caption?: string;
  compact?: boolean;
};

const { asset, title, caption, compact = false } = Astro.props;
const ready = asset?.status === "ready" && asset.src;
const fitClass = asset?.fit === "contain" ? "object-contain" : "object-cover";
---

<figure
  class="construct-block relative overflow-hidden bg-white"
  style={compact ? "padding: 12px;" : "padding: 16px;"}
>
  {ready ? (
    <img
      class:list={["w-full bg-white", compact ? "aspect-[4/3] min-h-44" : "aspect-[16/10] min-h-80", fitClass]}
      src={asset!.src}
      alt={asset!.label}
      loading="lazy"
    />
  ) : (
    <div
      class:list={[
        "grid place-items-center border-2 border-dashed",
        compact ? "min-h-44" : "min-h-80",
      ]}
      style="border-color: rgb(var(--c-accent-1-rgb) / 0.5); background: rgb(var(--c-primary-rgb) / 0.05);"
    >
      <span class="construct-diamond-outline mb-3" style="width: 1.5rem; height: 1.5rem;"></span>
      <p class="text-sm font-bold text-[var(--c-base)]">{title}</p>
      <p class="mt-1 text-xs uppercase tracking-wide text-black/40">Pending</p>
    </div>
  )}
  {caption && (
    <figcaption class="mt-3 font-mono text-xs text-black/50">{caption}</figcaption>
  )}
</figure>
