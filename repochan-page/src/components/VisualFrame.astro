---
import type { RepoChanAsset } from "../config/assets";

type Props = {
  asset?: RepoChanAsset;
  title: string;
  caption?: string;
  compact?: boolean;
};

const { asset, title, caption, compact = false } = Astro.props;
const ready = asset?.status === "ready" && asset.src;
const fitClass = asset?.fit === "contain" ? "object-contain" : "object-cover";
---

<figure class:list={[
  "relative overflow-hidden border border-slate-200 bg-white shadow-soft-line",
  compact ? "rounded-md p-4" : "rounded-lg p-5"
]}>
  {ready ? (
    <img class:list={[
      "h-full w-full rounded-md bg-slate-50",
      compact ? "aspect-[4/3] min-h-44" : "aspect-[16/10] min-h-80",
      fitClass
    ]} src={asset!.src} alt={asset!.label} loading="lazy" />
  ) : (
    <div class:list={[
      "pattern-field relative grid place-items-center rounded-md border border-dashed border-blue-300 bg-slate-50",
      compact ? "min-h-44" : "min-h-80"
    ]}>
      <div class="absolute inset-x-8 top-8 h-px protocol-thread"></div>
      <div class="absolute bottom-8 left-8 h-14 w-20 rounded-md border border-cyanline/50 bg-white/75"></div>
      <div class="absolute right-10 top-14 h-16 w-24 rounded-md border border-violet/50 bg-white/80"></div>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-blueprint">{asset?.orderId ?? "repochan asset"}</p>
        <p class="mt-3 max-w-xs text-lg font-semibold text-ink">{title}</p>
        <p class="mt-2 text-sm text-slate-500">{asset?.status === "pending" ? "Pending image result" : "Configurable visual slot"}</p>
      </div>
    </div>
  )}
  {caption && <figcaption class="mt-3 text-sm text-slate-500">{caption}</figcaption>}
</figure>
