        {
          "title": "开创作订单",
          "desc": "美术总监一次开齐全部 Asset Orders，设定集优先。",
          "command": "repochan order create"
        },
        {
          "title": "画师出图",
          "desc": "按订单生成设定集、贴纸、海报；不满意就重画，旧版自动成为历史。",
          "command": "repochan image gen"
        },
        {
          "title": "装配成站",
          "desc": "资产装进落地页，开幕——就像你现在站着的这间美术馆。",
          "command": "repochan starter pull"
        }
