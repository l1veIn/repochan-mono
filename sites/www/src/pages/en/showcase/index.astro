---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import MuseumNav from "../../../components/MuseumNav.astro";
import GalleryShowcase from "../../../components/GalleryShowcase.astro";
import Colophon from "../../../components/Colophon.astro";
import { getContent } from "../../../lib/site";
import { navForSubpage } from "../../../lib/nav";

const t = getContent("en");
const nav = navForSubpage(t.nav, "en");
---

<SiteLayout
  title={t.showcase.pageTitle}
  description={t.showcase.pageDescription}
  locale="en"
  lightbox={t.lightbox}
  path="/en/showcase/"
>
  <MuseumNav content={nav} locale="en" command={t.lobby.ctaPrimaryCommand} copied={t.lobby.copied} />
  <main>
    <GalleryShowcase locale="en" content={t.showcase} mode="full" />
  </main>
  <Colophon content={t.colophon} locale="en" />
</SiteLayout>
