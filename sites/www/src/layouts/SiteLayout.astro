---
import "../styles/global.css";
import { site, assets, alternatePath, buildCssVars, siteOrigin, type Locale } from "../lib/site";

type Props = {
  title: string;
  description: string;
  locale: Locale;
  /** Kept for call-site compatibility; zoom UI is Viewer.js (not custom lightbox). */
  lightbox?: { close: string; prev: string; next: string };
  /** Optional absolute path for hreflang self (defaults to / or /en/) */
  path?: string;
};

const { title, description, locale, path } = Astro.props;
const htmlLang = locale === "zh" ? "zh-CN" : "en";
const cssVars = buildCssVars();
const selfPath = path ?? (locale === "zh" ? "/" : "/en/");
const altPath = alternatePath(locale, selfPath);
const ogImage = assets.og.src.startsWith("http") ? assets.og.src : `${siteOrigin}${assets.og.src}`;
const canonical = `${siteOrigin}${selfPath}`;
---

<!doctype html>
<html lang={htmlLang} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      Locale auto-switch (runs before paint when possible):
      - prefers Chinese if browser language starts with zh
      - otherwise English
      - localStorage.repochan_locale = "zh"|"en" wins after manual switch
    */}
    <script is:inline>
      (function () {
        try {
          var KEY = "repochan_locale";
          var path = location.pathname || "/";
          var onEn = path === "/en" || path === "/en/" || path.indexOf("/en/") === 0;
          var pageLocale = onEn ? "en" : "zh";
          var stored = localStorage.getItem(KEY);

          function prefersZh() {
            var langs =
              navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || "en"];
            for (var i = 0; i < langs.length; i++) {
              if (String(langs[i]).toLowerCase().indexOf("zh") === 0) return true;
            }
            return false;
          }

          function withSlash(p) {
            if (!p || p === "/") return "/";
            return p.charAt(p.length - 1) === "/" ? p : p + "/";
          }

          function toEn(p) {
            p = withSlash(p);
            if (p === "/en/" || p.indexOf("/en/") === 0) return p;
            if (p === "/") return "/en/";
            return "/en" + p;
          }

          function toZh(p) {
            p = withSlash(p);
            if (p === "/en/") return "/";
            if (p.indexOf("/en/") === 0) return p.slice(3) || "/";
            return p;
          }

          var desired =
            stored === "zh" || stored === "en" ? stored : prefersZh() ? "zh" : "en";

          if (desired !== pageLocale) {
            var next = desired === "en" ? toEn(path) : toZh(path);
            if (next !== withSlash(path) && next !== path) {
              location.replace(next + location.search + location.hash);
            }
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.theme.base} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RepoChan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" hreflang={htmlLang} href={`${siteOrigin}${selfPath}`} />
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={`${siteOrigin}${altPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/en/`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&family=Noto+Serif+SC:wght@400;600&family=Noto+Sans+SC:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={cssVars} />
  </head>
  <body>
    <slot />
    {/* Image zoom / pan handled by Viewer.js in motion.ts (no custom lightbox DOM). */}
    <script>
      import "../lib/motion";
    </script>
    {/*
      Cloudflare Web Analytics (privacy-first RUM).
      Site created with auto_install for zone repochan.com; Pages HTML still needs
      the public site token for reliable beacon delivery.
    */}
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"a202915ba0c740289045abbe3b12930a"}'
    ></script>
  </body>
</html>
